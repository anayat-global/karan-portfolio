---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap row">
    <a href="/" class="brand">
      <div class="mark">KA</div>
      Karan Arora
    </a>
    <p class="cpy">&copy; {year} Karan Arora. All rights reserved.</p>
    <div class="fl">
      <a href="/about">About</a>
      <a href="/projects">Projects</a>
      <a href="/blog">Blog</a>
      <a href="/contact">Contact</a>
      <a href="/terms">Terms</a>
      <a href="/privacy">Privacy</a>
    </div>
  </div>
</footer>

<style>
.footer {
  background: var(--olive-dark);
  color: #C7C4AC;
  border-top: 1px solid rgba(255,255,255,.1);
  padding: 34px 0;
}
.footer .row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 18px;
}
.footer .brand {
  display: flex;
  align-items: center;
  gap: 11px;
  color: #EFEBDC;
  font-family: var(--display);
  font-weight: 800;
  font-size: 16px;
}
.footer .mark {
  width: 38px;
  height: 38px;
  border-radius: 11px;
  background: #EFEBDC;
  color: var(--olive-dark);
  display: grid;
  place-items: center;
  font-size: 14px;
  font-weight: 800;
}
.footer .cpy { font-size: 13px; }
.footer .fl { display: flex; gap: 26px; font-size: 13.5px; flex-wrap: wrap; }
.footer .fl a:hover { color: #EFEBDC; }
@media (max-width: 768px) {
  .footer .row { flex-direction: column; text-align: center; }
  .footer .fl { justify-content: center; gap: 16px; }
}
</style>
