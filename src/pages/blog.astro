---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getBlogPosts, categoryOf, formatDate } from '../lib/content';

const all = await getBlogPosts();
const [featured, ...posts] = all;
---


<Layout title="Blog | Karandeep Arora" description="Articles on WordPress, React JS, Python, PHP, Magento and Twilio development, and on hiring a freelance full stack developer.">
<Header activePage="/blog" />

<!-- HERO -->
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow reveal">Blog</span>
    <h1 class="reveal">Articles &<br>Insights</h1>
    <p class="reveal">Practical writing on WordPress, React JS, Python, PHP, Magento and Twilio development, and on working with a freelance developer.</p>
  </div>
</section>

<!-- FEATURED -->
<section class="section featured-section">
  <div class="wrap">
    <span class="eyebrow reveal">Featured Article</span>
    <a href={`/blog/${featured.slug}`} class="featured-card reveal">
      <div class="featured-img">
        <img src={featured.image} alt={featured.title} />
        <div class="feat-category">{categoryOf(featured)}</div>
      </div>
      <div class="featured-body">
        <div class="feat-meta">{formatDate(featured.publishDate)} · {featured.readTime}</div>
        <h2 class="feat-title">{featured.title}</h2>
        <p class="feat-excerpt">{featured.excerpt}</p>
        <span class="feat-read">Read Full Article →</span>
      </div>
    </a>
  </div>
</section>

<!-- ALL POSTS -->
<section class="section blog-section">
  <div class="wrap">
    <div class="blog-head reveal">
      <h2 class="serif-title">All Articles</h2>
    </div>
    <div class="blog-posts-grid">
      {posts.map(post => (
        <article class="blog-card reveal">
          <a href={`/blog/${post.slug}`} class="blog-card-link">
            <div class="blog-img">
              <img src={post.image} alt={post.title} loading="lazy" />
            </div>
            <div class="blog-body">
              <div class="blog-meta">
                <span class="blog-cat">{categoryOf(post)}</span>
                <span class="blog-date">{formatDate(post.publishDate)} · {post.readTime}</span>
              </div>
              <h3 class="blog-title">{post.title}</h3>
              <span class="blog-read">Read More →</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<Footer />
</Layout>

<style>
.featured-section { background: var(--cream); }
.featured-card { display: grid; grid-template-columns: 1.2fr 1fr; gap: 52px; align-items: center; text-decoration: none; margin-top: 32px; }
.featured-img { position: relative; border-radius: var(--r-lg); overflow: hidden; aspect-ratio: 16/10; box-shadow: var(--shadow-lg); }
.featured-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
.featured-card:hover .featured-img img { transform: scale(1.04); }
.feat-category { position: absolute; top: 18px; left: 18px; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; color: var(--ink); background: var(--gold-2); padding: 4px 12px; border-radius: 20px; }
.feat-meta { font-size: 12px; color: var(--muted); letter-spacing: .04em; margin-bottom: 14px; }
.feat-title { font-family: var(--serif); font-size: clamp(24px, 3vw, 36px); font-weight: 700; color: var(--ink); line-height: 1.2; margin-bottom: 18px; }
.feat-excerpt { font-size: 15px; color: var(--muted); line-height: 1.75; margin-bottom: 24px; }
.feat-read { font-size: 14px; font-weight: 700; color: var(--olive); border-bottom: 1.5px solid var(--olive); padding-bottom: 2px; }

.blog-section { background: var(--cream-2); }
.blog-head { margin-bottom: 44px; }
.blog-head .serif-title { font-size: clamp(28px, 3.5vw, 40px); }
.blog-posts-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
.blog-card { background: var(--white); border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line-2); box-shadow: var(--shadow-sm); transition: .3s; }
.blog-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }
.blog-card-link { text-decoration: none; display: block; }
.blog-img { aspect-ratio: 16/10; overflow: hidden; }
.blog-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
.blog-card:hover .blog-img img { transform: scale(1.05); }
.blog-body { padding: 22px 24px 26px; }
.blog-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.blog-cat { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; font-weight: 700; color: var(--gold); }
.blog-date { font-size: 12px; color: var(--muted); }
.blog-title { font-family: var(--serif); font-weight: 700; font-size: 18px; color: var(--ink); line-height: 1.35; margin-bottom: 14px; }
.blog-read { font-size: 13px; font-weight: 600; color: var(--olive); }

@media (max-width: 980px) {
  .featured-card { grid-template-columns: 1fr; gap: 28px; }
  .blog-posts-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .blog-posts-grid { grid-template-columns: 1fr; }
}
</style>
