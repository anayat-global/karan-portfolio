</style>

<script>
  // Filter buttons
  const filters = document.getElementById('filters');
  const grid = document.getElementById('projGrid');
  filters?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    filters.querySelectorAll('button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const f = btn.dataset.f;
    grid?.querySelectorAll<HTMLElement>('.proj').forEach(p => {
      p.style.display = (f === 'all' || p.dataset.cat === f) ? '' : 'none';
    });
  });

  // FAQ accordion
  document.querySelectorAll('.faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const isOpen = item?.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!isOpen) item?.classList.add('open');
    });
  });

  // Skill bars animate on scroll
  const barObserver = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll<HTMLElement>('.bar i').forEach(bar => {
          bar.style.width = bar.dataset.w || '0%';
        });
        barObserver.unobserve(e.target);
      }
    });
  }, { threshold: 0.2 });
  document.querySelectorAll('.skill-card').forEach(card => barObserver.observe(card));
</script>
