  .hero h1 { font-size: clamp(42px, 6vw, 47px); }
}
@media (max-width: 1024px) {
  .stats-bar { padding: 16px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
}
@media (max-width: 980px) {
  .hero-grid { grid-template-columns: 1fr; gap: 36px; }
  .hero-photo { max-width: 420px; margin: 0 auto; }
  .about-cards, .skill-cols, .svc-grid, .proj-grid, .tst-grid, .blog-grid { grid-template-columns: repeat(2, 1fr); }
  .steps { grid-template-columns: repeat(2, 1fr); gap: 34px 20px; }
