---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, HERO_STATS, STATS, SKILL_GROUPS, PROCESS, TESTIMONIALS, PORTFOLIO, FAQS } from '../data/site';
import { getBlogPosts, getServices, formatDate } from '../lib/content';

const [posts, services] = await Promise.all([getBlogPosts(), getServices()]);
const latest = posts.slice(0, 3);
const svcIcons = [7, 8, 9, 12, 10, 11, 4];
const svcBlurb: Record<string, string> = {
  'wordpress-development-services': 'Custom themes, plugins, WooCommerce stores, migrations, speed and security for startups and small businesses.',
  'twilio-development-services': 'SMS, voice, video, Flex and Studio integrations that connect your product to your customers.',
  'react-js-development-services': 'Interactive, scalable web and mobile apps built with React JS and React Native.',
  'python-development-services': 'Web apps, APIs, Django development and integrations built with Python.',
  'php-development-services': 'Secure, dynamic PHP applications, APIs and enterprise-grade web platforms.',
  'magento-development-services': 'Custom Magento stores, themes, migrations and performance optimisation for e-commerce.',
  'backend-development-services': 'Robust backends, cloud services, CRM/ERP systems and API integrations that scale.',
};
---


<Layout title="Karandeep Arora | Freelance Full Stack WordPress, React & Twilio Developer in India" description={SITE.defaultDescription}>
<Header activePage="/" />

<!-- ============ HERO ============ -->
<section class="hero" id="home">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-text reveal">
        <span class="hero-badge"><span class="dot"></span> I Build Modern</span>
        <h1>Digital Products<br>That <span class="scale">Scale.</span></h1>
        <p class="lead">Hi, I'm Karandeep Arora, a freelance full stack developer in India. I create better interfaces and experiences, making web and mobile applications easier and friendlier to use.</p>
        <div class="hero-btns">
          <a href="/portfolio" class="btn btn-dark">View My Work <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg></a>
          <a href="/contact" class="btn btn-outline">Let's Talk <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg></a>
        </div>
      </div>
      <div class="hero-photo reveal">
        <span class="code-chip tl">&lt;/&gt;</span>
        <span class="code-chip br">{ }</span>
        <div class="frame">
          <img src="/demo-removebg-preview.png" alt="Karandeep Arora" />
        </div>
      </div>
    </div>

    <div class="stats-bar reveal">
      <div class="stat">
        <div class="ic"><svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg></div>
        <div><div class="num">{HERO_STATS[0].value}</div><div class="lab">{HERO_STATS[0].label}</div></div>
      </div>
      <div class="stat">
        <div class="ic"><svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg></div>
        <div><div class="num">{HERO_STATS[1].value}</div><div class="lab">{HERO_STATS[1].label}</div></div>
      </div>
      <div class="stat">
        <div class="ic"><svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg></div>
        <div><div class="num">{HERO_STATS[2].value}</div><div class="lab">{HERO_STATS[2].label}</div></div>
      </div>
      <div class="stat">
        <div class="ic"><svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg></div>
        <div><div class="num">{HERO_STATS[3].value}</div><div class="lab">{HERO_STATS[3].label}</div></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ TRUSTED ============ -->
<section class="trusted">
  <div class="wrap">
    <p class="cap">Trusted by clients across the world</p>
    <div class="logos reveal">
      <span>Australia</span><span>United States</span><span>United Kingdom</span><span>Canada</span><span>Japan</span><span>India</span>
    </div>
  </div>
</section>

<!-- ============ ABOUT ============ -->
<section class="section about" id="about">
  <div class="wrap">
    <span class="eyebrow reveal">About Me</span>
    <h2 class="serif-title reveal">A Full Stack Developer with 10 Years of Experience</h2>
    <p class="about-lead reveal">I am an expert freelance full stack and MERN stack developer, building cost-effective, customised and scalable web solutions. From consulting and development to launch, I handle your project with clean code, a focus on your budget, and a fully responsive result on every device.</p>
    <div class="about-cards">
      <div class="about-card reveal">
        <div class="ic"><img src="/icons/Icon.svg" alt="" /></div>
        <h3>B.Tech</h3>
        <div class="role">Punjab Technical University, 2010–2014</div>
        <p>Engineering foundation, followed by Core and Advanced Java training at Stellar Edge Infotech.</p>
      </div>
      <div class="about-card reveal">
        <div class="ic"><img src="/icons/Icon_1.svg" alt="" /></div>
        <h3>Senior Consultant</h3>
        <div class="role">Freelance, 2019–Present</div>
        <p>Building websites and apps for startups, founders and businesses worldwide, after roles at Seasia Infotech and Smartbuzz.</p>
      </div>
      <div class="about-card reveal">
        <div class="ic"><img src="/icons/Icon_2.svg" alt="" /></div>
        <h3>55+ Happy Clients</h3>
        <div class="role">30+ repeat clients</div>
        <p>90+ projects and 6,000+ hours delivered across WordPress, React, Twilio, Python, PHP and Magento.</p>
      </div>
    </div>
    <div class="resume-wrap reveal">
      <a href="/about" class="btn btn-olive">More About Me <img src="/icons/Icon_3.svg" alt="" /></a>
      <div class="decade">— A Decade of Experience —</div>
    </div>
  </div>
</section>

<!-- ============ TECHNICAL ARSENAL ============ -->
<section class="section arsenal" id="skills">
  <div class="wrap">
    <div class="head reveal">
      <h2 class="serif-title">Tools and Skills</h2>
      <p>The technologies I use every day to build robust, scalable software for clients.</p>
    </div>
    <div class="skill-cols">
      {SKILL_GROUPS.map((g) => (
      <div class="skill-card reveal">
        <div class="top"><div class="ic"><img src={`/icons/Icon_${g.icon}.svg`} alt="" /></div><h3>{g.title}</h3></div>
        {g.skills.map(([name, pct]) => (
        <div class="skill-row"><div class="l"><span>{name}</span><span class="pct">{pct}%</span></div><div class="bar"><i data-w={`${pct}%`}></i></div></div>
        ))}
      </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ SERVICES ============ -->
<section class="section services">
  <div class="wrap">
    <span class="eyebrow reveal">Services</span>
    <h2 class="serif-title reveal">My Services</h2>
    <p class="sub reveal">Full stack web development across the platforms businesses rely on, built for reliability, speed and long-term scale.</p>
    <div class="svc-grid">
      {services.map((sv, i) => (
      <a href={`/${sv.slug}`} class="svc-card reveal"><div class="ic"><img src={`/icons/Icon_${svcIcons[i % svcIcons.length]}.svg`} alt="" /></div><h3>{sv.title}</h3><p>{svcBlurb[sv.slug] ?? sv.description}</p></a>
      ))}
    </div>
  </div>
</section>

<!-- ============ PORTFOLIO ============ -->
<section class="section portfolio" id="projects">
  <div class="wrap">
    <div class="head reveal">
      <div>
        <span class="eyebrow">Portfolio</span>
        <h2 class="serif-title">Featured Projects</h2>
      </div>
    </div>
    <div class="proj-grid" id="projGrid">
      {PORTFOLIO.map((pr) => (
      <article class="proj reveal">
        <div class="thumb"><span class="arrow">↗</span><img src={pr.img} alt={pr.title} loading="lazy" /></div>
        <div class="body"><h3>{pr.title}</h3><div class="tags">{pr.category}</div></div>
      </article>
      ))}
    </div>
    <div class="view-all-wrap reveal">
      <a href="/portfolio" class="btn btn-outline">View Full Portfolio →</a>
    </div>
  </div>
</section>

<!-- ============ PROCESS ============ -->
<section class="section process">
  <div class="wrap">
    <span class="eyebrow reveal">How I Work</span>
    <h2 class="serif-title reveal">My Method to Work on Projects</h2>
    <p class="sub reveal">From the first conversation to final delivery, a clear and transparent process.</p>
    <div class="steps">
      {PROCESS.map((st, i) => (
      <div class="step reveal"><div class="circle">{String(i + 1).padStart(2, '0')}</div><h3>{st.title}</h3><p>{st.text}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- ============ TESTIMONIALS ============ -->
<section class="section feedback" id="experience">
  <div class="wrap">
    <span class="eyebrow reveal">Testimonials</span>
    <h2 class="serif-title reveal">Client Feedback</h2>
    <div class="tst-grid">
      {TESTIMONIALS.slice(0, 3).map((t) => (
      <div class="tst reveal">
        <div class="stars">★★★★★</div>
        <p class="quote">"{t.quote}"</p>
        <div class="who"><div><div class="n">{t.name}</div><div class="r">{t.meta}</div></div></div>
      </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ STATS BAND ============ -->
<section class="band">
  <div class="wrap band-grid">
    {STATS.map((st) => (
    <div class="cell reveal"><div class="big">{st.value}</div><div class="lab">{st.label}</div></div>
    ))}
  </div>
</section>

<!-- ============ INSIGHTS ============ -->
<section class="section insights">
  <div class="wrap">
    <div class="head reveal">
      <h2 class="serif-title">From the Blog</h2>
      <a href="/blog" class="view-all">View All Articles <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M9.13125 6.75H0V5.25H9.13125L4.93125 1.05L6 0L12 6L6 12L4.93125 10.95L9.13125 6.75Z" fill="currentColor"/></svg></a>
    </div>
    <div class="blog-grid">
      {latest.map((p) => (
      <article class="post reveal">
        <div class="thumb"><img src={p.image} alt={p.title} loading="lazy" /></div>
        <div class="body"><div class="meta">{formatDate(p.publishDate)} · {p.readTime}</div><h3>{p.title}</h3><a class="read" href={`/blog/${p.slug}`}>Read More <img src="/icons/Icon_17.svg" alt="" /></a></div>
      </article>
      ))}
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="section faq">
  <div class="wrap">
    <span class="eyebrow reveal">FAQ</span>
    <h2 class="serif-title reveal">Frequently Asked Questions</h2>
    <div class="faq-list">
      {FAQS.slice(0, 3).map((f, i) => (
      <div class={`faq-item reveal${i === 0 ? ' open' : ''}`}>
        <button class="faq-q">{f.q} <span class="plus">+</span></button>
        <div class="faq-a"><p>{f.a}</p></div>
      </div>
      ))}
    </div>
    <div style="text-align:center;margin-top:32px"><a href="/faq" class="btn btn-outline">View All FAQs →</a></div>
  </div>
</section>

<!-- ============ CONTACT CTA ============ -->
<section class="cta">
  <div class="wrap">
    <h2>Ready to Build Something <em>Exceptional?</em></h2>
    <p>Tell me about your project. I take on freelance and contract work and I am available across time zones.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap">
      <a href="/contact" class="btn btn-cream">Start a Project</a>
      <a href="/about" class="btn" style="color:var(--cream-3);border-color:rgba(255,255,255,.3)">Learn About Me →</a>
    </div>
  </div>
</section>

<Footer />
</Layout>

<style>
/* HERO */
.hero {
  position: relative;
  background-image: url('/plan.png');
  padding: 64px 0 40px;
  background-repeat: no-repeat;
  width: 100%;
  background-size: cover;
}
.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: repeating-radial-gradient(circle at 78% 60%, transparent 0 38px, rgba(86,92,43,.045) 38px 39px);
  opacity: .6;
  pointer-events: none;
}
.hero-grid {
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  gap: 40px;
  align-items: center;
  position: relative;
  z-index: 2;
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--olive);
  margin-bottom: 22px;
  position: relative;
}
.hero-badge::before {
  content: "";
  width: 56px;
  height: 2px;
  background: rgb(193 155 82);
  border-radius: 2px;
  bottom: -3px;
  position: absolute;
}
.hero-badge .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); }
.hero h1 {
  font-family: "Bebas Neue", sans-serif;
  font-weight: 700;
  font-size: clamp(42px, 6vw, 60px);
  line-height: 1.02;
  letter-spacing: -.02em;
  text-transform: uppercase;
  color: var(--ink);
  margin-bottom: 24px;
}
.hero h1 .scale {
  font-family: var(--serif);
  font-style: italic;
  font-weight: 600;
  text-transform: none;
  color: var(--gold);
  letter-spacing: -.01em;
  font-size: 70px;
}
.hero p.lead { font-size: 20px; color: #373633; max-width: 440px; margin-bottom: 30px; }
.hero-btns { display: flex; gap: 14px; flex-wrap: wrap; }
.hero-photo { position: relative; }
.hero-photo .frame::before {
  content: '';
  position: absolute;
  border-radius: 100%;
  box-shadow: var(--shadow-lg);
  border: 3px solid rgb(193 155 82 / 37%);
  aspect-ratio: 3/3;
  background: rgb(195 176 137 / 53%);
  width: 100%;
  z-index: -2;
}
.hero-photo .frame { position: relative; }
.hero-photo .frame img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
.hero-photo .frame::after {
  content: "";
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 150px;
  background: linear-gradient(to bottom, transparent 0%, rgba(247,241,229,.35) 35%, rgba(247,241,229,.8) 75%, #f7f1e5 100%);
  z-index: 2;
}
.hero-photo::after {
  content: "";
  position: absolute;
  inset: -30px -22px auto auto;
  width: 230px; height: 230px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(185,149,64,.28), transparent 70%);
  z-index: -1;
}
.code-chip { position: absolute; font-family: var(--display); font-weight: 800; color: var(--gold); font-size: 22px; opacity: .7; }
.code-chip.tl { top: 6px; left: -10px; }
.code-chip.br { bottom: 20px; right: -6px; }

/* STATS BAR */
.stats-bar {
  margin-top: 0;
  background: var(--white);
  border-radius: 20px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 2rem;
  box-shadow: 0 10px 30px rgba(0,0,0,.05);
  position: relative;
  z-index: 3;
}
.stat { display: flex; align-items: center; gap: 14px; padding: 6px 22px; border-right: 1.5px solid var(--line-2); }
.stat:last-child { border-right: 0; }
.stat .ic { width: 70px; height: 70px; border-radius: 50px; flex: none; background: #f8ebca; display: grid; place-items: center; color: var(--olive); }
.stat .ic svg { max-width: 32px; width: 100%; color: rgb(199 158 78); }
.stat .num { font-family: var(--display); font-weight: 800; font-size: 28px; color: var(--ink); line-height: 1; }
.stat .lab { font-size: 14px; color: var(--muted); margin-top: 3px; }

/* TRUSTED */
.trusted { background: var(--cream); padding: 44px 0 8px; }
.trusted .cap { text-align: center; font-size: 12px; letter-spacing: .24em; text-transform: uppercase; color: var(--muted); font-weight: 600; margin-bottom: 26px; }
.logos { display: flex; align-items: center; justify-content: center; gap: 56px; flex-wrap: wrap; }
.logos span { font-family: var(--serif); font-weight: 600; font-size: 26px; color: #B4AC98; transition: color .25s; }
.logos span:hover { color: var(--olive); }

/* ABOUT */
.about { background: var(--cream-2); text-align: center; }
.about .serif-title { font-size: clamp(32px, 4.4vw, 52px); margin: 16px auto 0; max-width: 720px; }
.about-lead { max-width: 640px; margin: 26px auto 0; color: var(--muted); font-size: 16px; }
.about-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 52px; text-align: left; }
.about-card { background: var(--white); border-radius: var(--r-md); padding: 30px 28px; border: 1px solid var(--line-2); box-shadow: var(--shadow-sm); transition: .25s; }
.about-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }
.about-card .ic { width: 52px; height: 52px; border-radius: 14px; background: var(--cream-2); display: grid; place-items: center; color: var(--gold); margin-bottom: 18px; background-color: rgba(200,164,77,.1); }
.about-card h3 { font-family: var(--serif); font-weight: 700; font-size: 20px; margin-bottom: 8px; }
.about-card .role { font-size: 13px; color: var(--olive); font-weight: 600; margin-bottom: 10px; }
.about-card p { font-size: 14px; color: var(--muted); }
.resume-wrap { margin-top: 44px; }
.decade { margin-top: 26px; font-size: 11.5px; letter-spacing: .24em; text-transform: uppercase; color: var(--muted); font-weight: 600; }

/* ARSENAL */
.arsenal { background: var(--cream); }
.arsenal .head { text-align: center; max-width: 620px; margin: 0 auto 54px; }
.arsenal .serif-title { font-size: clamp(30px, 4vw, 46px); }
.arsenal .head p { color: var(--muted); margin-top: 16px; font-size: 16px; }
.skill-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.skill-card { background: var(--white); border-radius: var(--r-md); padding: 30px 28px; border: 1px solid var(--line-2); box-shadow: var(--shadow-sm); }
.skill-card .top { display: flex; align-items: center; gap: 14px; margin-bottom: 26px; }
.skill-card .top .ic { width: 48px; height: 48px; border-radius: 12px; display: grid; place-items: center; color: #fff; }
.skill-card:nth-child(1) .ic { background: var(--olive); }
.skill-card:nth-child(2) .ic { background: var(--gold); }
.skill-card:nth-child(3) .ic { background: var(--ink); }
.skill-card h3 { font-family: var(--serif); font-weight: 700; font-size: 19px; }
.skill-row { margin-bottom: 18px; }
.skill-row:last-child { margin-bottom: 0; }
.skill-row .l { display: flex; justify-content: space-between; font-size: 13.5px; font-weight: 500; margin-bottom: 7px; }
.skill-row .l .pct { color: var(--muted); }
.bar { height: 7px; border-radius: 6px; background: var(--line-2); overflow: hidden; }
.bar i { display: block; height: 100%; border-radius: 6px; width: 0; transition: width 1.1s cubic-bezier(.2,.7,.2,1); }
.skill-card:nth-child(1) .bar i { background: var(--olive); }
.skill-card:nth-child(2) .bar i { background: var(--gold); }
.skill-card:nth-child(3) .bar i { background: var(--ink); }

/* SERVICES */
.services { background: var(--cream-2); text-align: center; }
.services .serif-title { font-size: clamp(30px, 4vw, 46px); margin-top: 14px; }
.services .sub { color: var(--muted); margin: 18px auto 0; max-width: 560px; font-size: 16px; }
.svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 54px; text-align: left; }
.svc-card { background: var(--white); border-radius: var(--r-md); padding: 32px 28px; border: 1px solid var(--line-2); box-shadow: var(--shadow-sm); transition: .25s; position: relative; overflow: hidden; }
.svc-card::before { content: ""; position: absolute; left: 0; top: 0; height: 3px; width: 0; background: var(--gold); transition: .3s; }
.svc-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }
.svc-card:hover::before { width: 100%; }
.svc-card .ic { width: 54px; height: 54px; border-radius: 14px; background: var(--cream-2); display: grid; place-items: center; color: var(--olive); margin-bottom: 20px; }
.svc-card h3 { font-family: var(--serif); font-weight: 700; font-size: 20px; margin-bottom: 10px; }
.svc-card p { font-size: 14px; color: var(--muted); }

/* PORTFOLIO */
.portfolio { background: var(--cream); }
.portfolio .head { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 24px; margin-bottom: 44px; }
.portfolio .serif-title { font-size: clamp(30px, 4vw, 48px); margin-top: 12px; }
.filters { display: inline-flex; background: var(--white); border-radius: 40px; padding: 6px; border: 1px solid var(--line-2); box-shadow: var(--shadow-sm); }
.filters button { border: 0; background: transparent; cursor: pointer; font-family: var(--body); font-size: 14px; font-weight: 600; color: var(--muted); padding: 9px 22px; border-radius: 30px; transition: .2s; }
.filters button.active { background: var(--olive); color: #F2EEE1; }
.proj-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
.proj { background: var(--white); border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line-2); box-shadow: var(--shadow-sm); transition: .3s; }
.proj:hover { transform: translateY(-7px); box-shadow: var(--shadow-lg); }
.proj .thumb { position: relative; aspect-ratio: 16/11; overflow: hidden; }
.proj .thumb img { width: 100%; height: 100%; object-fit: cover; transition: .5s; }
