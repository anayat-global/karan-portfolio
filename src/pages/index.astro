---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, HERO_STATS, STATS, SKILL_GROUPS, PROCESS, TESTIMONIALS, PORTFOLIO, FAQS } from '../data/site';
import { HOURLY_RATES } from '../data/site';
import { getBlogPosts, getServices, formatDate } from '../lib/content';

const [posts, services] = await Promise.all([getBlogPosts(), getServices()]);
const latest = posts.slice(0, 3);
const svcIcons = [7, 8, 9, 12, 10, 11, 4];
const svcBlurb: Record<string, string> = {
  'wordpress-development-services': 'Custom themes, plugins, WooCommerce stores, migrations, speed and security.',
  'twilio-development-services': 'SMS, voice, video, Flex and Studio integrations that connect your product to customers.',
  'react-js-development-services': 'Interactive, scalable web and mobile apps with React JS and React Native.',
  'python-development-services': 'Web apps, APIs, Django development and integrations built with Python.',
  'php-development-services': 'Secure, dynamic PHP applications, APIs and enterprise-grade web platforms.',
  'magento-development-services': 'Custom Magento stores, themes, migrations and performance optimisation.',
  'backend-development-services': 'Robust backends, cloud services, CRM/ERP systems and API integrations.',
};
const clients = ['Australia', 'United States', 'United Kingdom', 'Canada', 'Japan', 'India', 'Italy', 'South Africa', 'Saudi Arabia'];
---

<Layout title="Karandeep Arora | Freelance Full Stack WordPress, React & Twilio Developer in India" description={SITE.defaultDescription}>
<Header activePage="/" />

<!-- ============ HERO ============ -->
<section class="hero" id="home">
  <div class="wrap">
    <div class="hero-grid">

      <div class="hero-text">
        <div class="hero-avail reveal">
          <span class="avail-dot"></span>
          <span>Available for new projects</span>
        </div>

        <h1 class="reveal">
          <span class="h1-label">Freelance Full Stack</span>
          <span class="h1-name">Developer</span>
          <span class="h1-sub">Building digital products<br>that <em>perform and scale.</em></span>
        </h1>

        <p class="hero-desc reveal">Hi, I'm Karandeep Arora — based in India, working with clients in Australia, the US, the UK, Canada and across the world. I specialise in WordPress, React JS, Python, PHP, Twilio and Magento.</p>

        <div class="hero-actions reveal">
          <a href="/portfolio" class="btn btn-primary">View My Work</a>
          <a href="/contact" class="btn btn-ghost">Start a Project →</a>
        </div>
      </div>

      <div class="hero-right reveal">
        <div class="portrait-wrap">
          <div class="portrait-bg"></div>
          <div class="portrait-frame">
            <img src="/karan-profile.webp" alt="Karandeep Arora — Freelance Full Stack Developer" />
          </div>
          <div class="portrait-tag portrait-tag-1">
            <strong>90+</strong><span>Projects Delivered</span>
          </div>
          <div class="portrait-tag portrait-tag-2">
            <strong>⭐ 5.0</strong><span>Upwork Rating</span>
          </div>
        </div>
        <div class="tech-tags">
          <span class="tech-tag">WordPress</span>
          <span class="tech-tag">React JS</span>
          <span class="tech-tag">Python</span>
          <span class="tech-tag">Twilio</span>
          <span class="tech-tag">PHP</span>
          <span class="tech-tag">Magento</span>
        </div>
      </div>

    </div>
  </div>

  <div class="stats-row">
    <div class="wrap">
      <div class="stats-inner">
        {HERO_STATS.map((s) => (
          <div class="stat-item reveal">
            <div class="stat-val" data-count={s.value.replace(/\D/g,'')} data-suffix={s.value.replace(/\d/g,'')}>{s.value}</div>
            <div class="stat-lbl">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ============ MARQUEE ============ -->
<div class="marquee-strip" aria-hidden="true">
  <div class="marquee-inner">
    {[...clients, ...clients, ...clients].map((c) => (
      <span class="m-item"><svg width="6" height="6" viewBox="0 0 6 6" fill="currentColor"><circle cx="3" cy="3" r="3"/></svg>{c}</span>
    ))}
  </div>
</div>

<!-- ============ ABOUT ============ -->
<section class="section about" id="about">
  <div class="wrap about-grid">
    <div class="about-copy">
      <span class="eyebrow reveal">About Me</span>
      <h2 class="serif-title reveal">A decade of building<br><em>products people use.</em></h2>
      <p class="body-lg reveal">Expert freelance full stack and MERN stack developer. I build cost-effective, scalable web solutions — from consulting and development through to launch and beyond.</p>
      <a href="/about" class="btn btn-primary reveal" style="margin-top:32px">More About Me</a>
    </div>
    <div class="about-cards">
      {[
        { n:'01', h:'B.Tech — 2014', sub:'Punjab Technical University', p:'Engineering foundation, followed by Core and Advanced Java training at Stellar Edge Infotech.' },
        { n:'02', h:'Senior Consultant', sub:'Freelance, 2019–Present', p:'Building websites and apps for startups, founders and businesses worldwide after roles at Seasia Infotech and Smartbuzz.' },
        { n:'03', h:'55+ Happy Clients', sub:'30+ repeat clients', p:'90+ projects and 6,000+ hours delivered across WordPress, React, Twilio, Python, PHP and Magento.' },
      ].map((card) => (
        <div class="about-card reveal">
          <div class="acard-n">{card.n}</div>
          <h3>{card.h}</h3>
          <div class="acard-sub">{card.sub}</div>
          <p>{card.p}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ SERVICES ============ -->
<section class="section services" id="services">
  <div class="wrap">
    <div class="sec-header reveal">
      <div>
        <span class="eyebrow">Services</span>
        <h2 class="serif-title">What I build</h2>
      </div>
      <p class="sec-desc">Full stack development across the platforms businesses rely on — built for reliability, speed and long-term scale.</p>
    </div>
    <div class="svc-grid">
      {services.map((sv, i) => (
        <a href={`/services/${sv.slug}`} class={`svc-card reveal${i === 0 ? ' svc-featured' : ''}`}>
          <div class="svc-n">0{i + 1}</div>
          <h3>{sv.title}</h3>
          <p>{svcBlurb[sv.slug] ?? sv.description}</p>
          {HOURLY_RATES[sv.slug] && <div class="svc-rate">${HOURLY_RATES[sv.slug]} / hr</div>}
          <div class="svc-arrow">↗</div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ============ PORTFOLIO ============ -->
<section class="sw-section" id="projects">
  <div class="sw-head wrap">
    <div class="sw-title-block">
      <h2 class="sw-title reveal">Selected<br>works<span class="sw-star">*</span></h2>
    </div>
    <div class="sw-meta">
      <span class="sw-badge">Web Dev</span>
      <a href="/portfolio" class="sw-all-link">View all work →</a>
    </div>
  </div>
  <div class="sw-grid wrap">
    {PORTFOLIO.map((pr, i) => (
      <a href="/portfolio" class={`sw-item sw-item-${i + 1} reveal`}>
        <div class="sw-img">
          <img src={pr.img} alt={pr.title} loading="lazy" />
          <span class="sw-hover-arrow">↗</span>
        </div>
        <div class="sw-info">
          <span class="sw-name">{pr.title}</span>
          <span class="sw-cat">{pr.category}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<!-- ============ PROCESS ============ -->
<section class="section process">
  <div class="wrap">
    <div class="sec-center reveal">
      <span class="eyebrow">How I Work</span>
      <h2 class="serif-title">My process</h2>
      <p>From the first conversation to final delivery — clear, transparent and collaborative.</p>
    </div>
    <div class="steps-grid">
      {PROCESS.map((st, i) => (
        <div class="step reveal">
          <div class="step-n">{String(i + 1).padStart(2,'0')}</div>
          <h3>{st.title}</h3>
          <p>{st.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ STATS BAND ============ -->
<section class="band">
  <div class="wrap band-inner">
    {STATS.map((st) => (
      <div class="band-item reveal">
        <div class="band-val" data-count={st.value.replace(/\D/g,'')} data-suffix={st.value.replace(/[\d]/g,'')}>{st.value}</div>
        <div class="band-lbl">{st.label}</div>
      </div>
    ))}
  </div>
</section>

<!-- ============ TESTIMONIALS ============ -->
<section class="section testimonials">
  <div class="wrap">
    <div class="tst-head reveal">
      <div>
        <span class="eyebrow">Testimonials</span>
        <h2 class="serif-title">What clients say</h2>
      </div>
      <div class="tst-rating-pill">
        <span class="tst-stars-sm">★★★★★</span>
        <span>5.0 on Upwork</span>
      </div>
    </div>
    <div class="tst-grid">
      {TESTIMONIALS.slice(0, 3).map((t) => (
        <div class="tst reveal">
          <div class="tst-quote-mark">"</div>
          <p class="tst-quote">{t.quote}</p>
          <div class="tst-author">
            <div class="tst-avatar">{t.name.charAt(0)}</div>
            <div class="tst-author-info">
              <strong>{t.name}</strong>
              <span>{t.meta}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ SKILLS ============ -->
<section class="section skills-sec" id="skills">
  <div class="wrap">
    <div class="sec-center reveal">
      <span class="eyebrow">Skills</span>
      <h2 class="serif-title">Tools & Technologies</h2>
      <p>The technologies I use every day to build robust, scalable software.</p>
    </div>
    <div class="skill-cols">
      {SKILL_GROUPS.map((g) => (
        <div class="skill-card reveal">
          <div class="sk-head">
            <div class="sk-ic"><img src={`/icons/Icon_${g.icon}.svg`} alt="" /></div>
            <h3>{g.title}</h3>
          </div>
          {g.skills.map(([name, pct]) => (
            <div class="sk-row">
              <div class="sk-meta"><span>{name}</span><span class="sk-pct">{pct}%</span></div>
              <div class="sk-bar"><i data-w={`${pct}%`}></i></div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ BLOG ============ -->
<section class="section blog-sec">
  <div class="wrap">
    <div class="sec-header reveal">
      <div>
        <span class="eyebrow">Blog</span>
        <h2 class="serif-title">From the Blog</h2>
      </div>
      <a href="/blog" class="sec-link">View all articles →</a>
    </div>
    <div class="blog-grid">
      {latest.map((p) => (
        <article class="blog-card reveal">
          <a href={`/blog/${p.slug}`} class="blog-card-link">
            <div class="blog-thumb"><img src={p.image} alt={p.title} loading="lazy" /></div>
            <div class="blog-body">
              <div class="blog-meta">{formatDate(p.publishDate)} · {p.readTime}</div>
              <h3>{p.title}</h3>
              <span class="blog-read">Read More →</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="section faq-sec">
  <div class="wrap faq-inner">
    <div class="faq-head">
      <span class="eyebrow reveal">FAQ</span>
      <h2 class="serif-title reveal">Frequently Asked<br>Questions</h2>
      <a href="/faq" class="btn btn-ghost reveal" style="margin-top:28px">View All FAQs →</a>
    </div>
    <div class="faq-list">
      {FAQS.slice(0, 4).map((f, i) => (
        <div class={`faq-item reveal${i === 0 ? ' open' : ''}`}>
          <button class="faq-q">{f.q}<span class="fq-icon">+</span></button>
          <div class="faq-a"><p>{f.a}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ CTA ============ -->
<section class="cta-band">
  <div class="wrap cta-inner reveal">
    <div class="cta-copy">
      <span class="eyebrow" style="color:var(--gold-2)">Let's Work Together</span>
      <h2>Ready to build<br><em>something exceptional?</em></h2>
      <p>I take on freelance and contract work and am available across time zones. Share your project — I'll send a proposal within 24 hours.</p>
    </div>
    <div class="cta-actions">
      <a href="/contact" class="btn btn-cream">Start a Project</a>
      <a href={SITE.upwork} class="btn btn-ghost-light" target="_blank" rel="noopener">Find Me on Upwork →</a>
    </div>
  </div>
</section>

<Footer />
</Layout>

<style>
/* ─── HERO ─────────────────────────────────────────────── */
.hero {
  background: var(--cream);
  padding: 80px 0 0;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  top: 0; right: 0;
  width: 55%; height: 100%;
  background: radial-gradient(ellipse 80% 70% at 80% 30%, rgba(185,149,64,.12) 0%, transparent 65%);
  pointer-events: none;
}
.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
  min-height: calc(100vh - 80px);
  padding-bottom: 60px;
}
.hero-avail {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 500;
  color: var(--muted);
  margin-bottom: 24px;
  letter-spacing: .01em;
}
.avail-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: #4ade80;
  box-shadow: 0 0 0 3px rgba(74,222,128,.22);
  flex: none;
  animation: pulse 2.4s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 3px rgba(74,222,128,.22); }
  50% { box-shadow: 0 0 0 6px rgba(74,222,128,.06); }
}
.h1-label {
  display: block;
  font-size: clamp(14px, 1.3vw, 16px);
  font-weight: 600;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 14px;
}
.h1-name {
  display: block;
  font-family: var(--serif);
  font-size: clamp(60px, 7.5vw, 96px);
  font-weight: 400;
  line-height: .95;
  letter-spacing: -.02em;
  color: var(--ink);
  margin-bottom: 18px;
}
.h1-sub {
  display: block;
  font-family: var(--serif);
  font-size: clamp(22px, 2.8vw, 34px);
  font-weight: 400;
  color: var(--ink-2);
  line-height: 1.3;
  margin-bottom: 28px;
}
.h1-sub em { font-style: italic; color: var(--gold); }
.hero-desc {
  font-size: clamp(15px, 1.4vw, 17px);
  color: var(--muted);
  max-width: 460px;
  line-height: 1.75;
  margin-bottom: 40px;
}
.hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }

/* Portrait */
.hero-right { display: flex; align-items: center; justify-content: center; }
.portrait-wrap { position: relative; width: 400px; }
.portrait-bg {
  position: absolute;
  inset: -20px;
  border-radius: 200px 200px 120px 120px;
  background: linear-gradient(160deg, rgba(185,149,64,.12) 0%, rgba(185,149,64,.05) 100%);
  z-index: 0;
}
.portrait-frame {
  position: relative; z-index: 1;
  width: 100%; aspect-ratio: 4/5;
  border-radius: 200px 200px 120px 120px;
  overflow: hidden;
  border: 2px solid rgba(185,149,64,.3);
  box-shadow: 0 32px 72px rgba(60,54,30,.14);
  background: var(--cream-2);
}
.portrait-frame img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
.portrait-tag {
  position: absolute;
  background: var(--white);
  border: 1px solid var(--line-2);
  border-radius: 12px;
  padding: 10px 16px;
  box-shadow: 0 6px 24px rgba(0,0,0,.09);
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 120px;
}
.portrait-tag strong {
  font-family: var(--display);
  font-weight: 700;
  font-size: 20px;
  color: var(--ink);
  line-height: 1;
}
.portrait-tag span { font-size: 11px; color: var(--muted); font-weight: 500; }
.portrait-tag-1 { bottom: 32px; left: -32px; }
.portrait-tag-2 { top: 48px; right: -28px; }

.tech-tags {
  display: flex; flex-wrap: wrap; gap: 8px;
  justify-content: center; margin-top: 24px;
  padding: 0 20px;
}
.tech-tag {
  background: var(--white); border: 1px solid var(--line-2);
  color: var(--ink-2); font-size: 12px; font-weight: 600;
  padding: 6px 14px; border-radius: 40px;
  letter-spacing: .03em; transition: .2s;
}
.tech-tag:hover { background: var(--olive); color: var(--cream-3); border-color: var(--olive); }

/* Stats row */
.stats-row {
  background: var(--white);
  border-top: 1px solid var(--line-2);
  margin-top: 0;
}
.stats-inner {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}
.stat-item {
  padding: 28px 32px;
  border-right: 1px solid var(--line-2);
  transition: background .2s;
}
.stat-item:last-child { border-right: 0; }
.stat-item:hover { background: var(--cream); }
.stat-val {
  font-family: var(--serif);
  font-size: clamp(32px, 3.2vw, 44px);
  font-weight: 400;
  color: var(--ink);
  line-height: 1;
}
.stat-lbl { font-size: 13px; color: var(--muted); margin-top: 6px; font-weight: 500; }

/* ─── BUTTONS ──────────────────────────────────────────── */
.btn-primary {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--olive); color: var(--cream-3);
  padding: 14px 28px; border-radius: 10px;
  font-weight: 600; font-size: 15px;
  border: 2px solid var(--olive);
  transition: .22s;
  font-family: var(--body);
  text-decoration: none;
}
.btn-primary:hover { background: var(--olive-dark); border-color: var(--olive-dark); transform: translateY(-2px); }
.btn-ghost {
  display: inline-flex; align-items: center; gap: 8px;
  background: transparent; color: var(--ink);
  padding: 14px 28px; border-radius: 10px;
  font-weight: 600; font-size: 15px;
  border: 2px solid var(--line);
  transition: .22s;
  font-family: var(--body);
  text-decoration: none;
}
.btn-ghost:hover { border-color: var(--olive); color: var(--olive); transform: translateY(-2px); }
.btn-cream {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--cream-3); color: var(--ink);
  padding: 14px 28px; border-radius: 10px;
  font-weight: 600; font-size: 15px;
  border: 2px solid var(--cream-3);
  transition: .22s;
  font-family: var(--body);
  text-decoration: none;
}
.btn-cream:hover { background: var(--white); transform: translateY(-2px); }
.btn-ghost-light {
  display: inline-flex; align-items: center; gap: 8px;
  background: transparent; color: rgba(251,248,240,.75);
  padding: 14px 28px; border-radius: 10px;
  font-weight: 600; font-size: 15px;
  border: 2px solid rgba(255,255,255,.2);
  transition: .22s;
  font-family: var(--body);
  text-decoration: none;
}
.btn-ghost-light:hover { border-color: rgba(255,255,255,.5); color: #fff; }

/* ─── MARQUEE ──────────────────────────────────────────── */
.marquee-strip {
  background: var(--olive-dark);
  padding: 13px 0;
  overflow: hidden;
}
.marquee-inner {
  display: inline-flex;
  white-space: nowrap;
  animation: marquee 28s linear infinite;
}
.m-item {
  display: inline-flex; align-items: center; gap: 12px;
  padding: 0 32px;
  font-size: 13px; font-weight: 600;
  letter-spacing: .1em; text-transform: uppercase;
  color: rgba(251,248,240,.6);
}
.m-item svg { color: var(--gold-2); flex: none; }
@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-33.333%); }
}

/* ─── SECTION UTILITIES ────────────────────────────────── */
.sec-header {
  display: flex; justify-content: space-between; align-items: flex-end;
  flex-wrap: wrap; gap: 20px; margin-bottom: 52px;
}
.sec-header .serif-title { font-size: clamp(30px, 3.8vw, 46px); margin-top: 10px; }
.sec-desc { font-size: 15px; color: var(--muted); max-width: 400px; line-height: 1.7; }
.sec-link {
  font-size: 14px; font-weight: 600; color: var(--olive);
  text-decoration: underline; text-underline-offset: 4px;
  white-space: nowrap;
}
.sec-link:hover { color: var(--olive-dark); }
.sec-center {
  text-align: center; max-width: 580px; margin: 0 auto 56px;
}
.sec-center .serif-title { font-size: clamp(30px, 3.8vw, 46px); margin: 10px 0 14px; }
.sec-center p { font-size: 16px; color: var(--muted); line-height: 1.7; }

/* ─── ABOUT ────────────────────────────────────────────── */
.about { background: var(--cream-2); }
.about-grid {
  display: grid; grid-template-columns: 1fr 1.5fr;
  gap: 80px; align-items: start;
}
.about-copy .serif-title { font-size: clamp(28px, 3.5vw, 44px); margin: 12px 0 20px; line-height: 1.15; }
.about-copy .serif-title em { font-style: italic; color: var(--gold); }
.body-lg { font-size: 16px; color: var(--muted); line-height: 1.8; }
.about-cards { display: flex; flex-direction: column; gap: 14px; }
.about-card {
  background: var(--white); border-radius: 14px; padding: 26px 28px;
  border: 1px solid var(--line-2); border-left: 3px solid var(--gold);
  transition: transform .22s, box-shadow .22s;
}
.about-card:hover { transform: translateX(5px); box-shadow: var(--shadow-sm); }
.acard-n {
  font-size: 11px; font-weight: 700; letter-spacing: .18em;
  color: var(--gold); margin-bottom: 8px;
}
.about-card h3 { font-family: var(--serif); font-size: 19px; font-weight: 400; margin-bottom: 4px; }
.acard-sub { font-size: 12.5px; color: var(--olive); font-weight: 600; margin-bottom: 8px; }
.about-card p { font-size: 14px; color: var(--muted); line-height: 1.65; }

/* ─── SERVICES ─────────────────────────────────────────── */
.services { background: var(--cream); }
.svc-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.svc-card {
  background: var(--white); border-radius: 14px;
  padding: 30px 28px; border: 1px solid var(--line-2);
