---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, HERO_STATS, STATS, SKILL_GROUPS, PROCESS, TESTIMONIALS, PORTFOLIO, FAQS } from '../data/site';
import { HOURLY_RATES } from '../data/site';
import { getBlogPosts, getServices, formatDate } from '../lib/content';

const [posts, services] = await Promise.all([getBlogPosts(), getServices()]);
const latest = posts.slice(0, 3);
const svcIcons = [7, 8, 9, 12, 10, 11, 4];
const svcBlurb: Record<string, string> = {
  'wordpress-development-services': 'Custom themes, plugins, WooCommerce stores, migrations, speed and security.',
  'twilio-development-services': 'SMS, voice, video, Flex and Studio integrations that connect your product to customers.',
  'react-js-development-services': 'Interactive, scalable web and mobile apps built with React JS and React Native.',
  'python-development-services': 'Web apps, APIs, Django development and integrations built with Python.',
  'php-development-services': 'Secure, dynamic PHP applications, APIs and enterprise-grade web platforms.',
  'magento-development-services': 'Custom Magento stores, themes, migrations and performance optimisation.',
  'backend-development-services': 'Robust backends, cloud services, CRM/ERP systems and API integrations that scale.',
};
const clients = ['Australia', 'United States', 'United Kingdom', 'Canada', 'Japan', 'India', 'Italy', 'South Africa', 'Saudi Arabia'];
---

<Layout title="Karandeep Arora | Freelance Full Stack WordPress, React & Twilio Developer in India" description={SITE.defaultDescription}>
<Header activePage="/" />

<!-- ============ HERO ============ -->
<section class="hero" id="home">
  <div class="hero-blob" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-2" aria-hidden="true"></div>
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-text">
        <div class="hero-badge reveal"><span class="avail-dot"></span> Available for Projects</div>
        <h1 class="reveal">
          <span class="h1-top">I Build Modern</span>
          <span class="h1-main">Digital<br>Products</span>
          <span class="h1-accent">That Scale.</span>
        </h1>
        <p class="lead reveal">Hi, I'm Karandeep Arora — a freelance full stack developer in India with 10+ years building web and mobile products for clients worldwide.</p>
        <div class="hero-btns reveal">
          <a href="/portfolio" class="btn btn-hero-primary">View My Work <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg></a>
          <a href="/contact" class="btn btn-hero-outline">Let's Talk</a>
        </div>
      </div>
      <div class="hero-photo reveal">
        <div class="photo-ring" aria-hidden="true"></div>
        <div class="photo-frame">
          <img src="/karan-profile.webp" alt="Karandeep Arora — Freelance Full Stack Developer" />
        </div>
        <div class="photo-badge">
          <div class="pb-num">90+</div>
          <div class="pb-label">Projects</div>
        </div>
        <div class="photo-badge-2">
          <div class="pb-num">⭐ 5.0</div>
          <div class="pb-label">Upwork Rating</div>
        </div>
      </div>
    </div>

    <div class="stats-bar reveal">
      {HERO_STATS.map((s) => (
        <div class="stat">
          <div class="stat-num" data-count={s.value.replace(/\D/g,'')} data-suffix={s.value.replace(/\d/g,'')}>{s.value}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ MARQUEE ============ -->
<div class="marquee-wrap" aria-hidden="true">
  <div class="marquee-track">
    {[...clients, ...clients, ...clients].map((c) => (
      <span class="marquee-item"><span class="marquee-dot">✦</span> {c}</span>
    ))}
  </div>
</div>

<!-- ============ ABOUT ============ -->
<section class="section about" id="about">
  <div class="wrap about-layout">
    <div class="about-left">
      <span class="eyebrow reveal">About Me</span>
      <h2 class="serif-title reveal">A Full Stack Developer<br><em>with 10 Years of<br>Experience</em></h2>
      <p class="about-lead reveal">Expert freelance full stack and MERN stack developer, building cost-effective, customised and scalable web solutions. From consulting to launch — clean code, on budget, fully responsive.</p>
      <a href="/about" class="btn btn-olive reveal" style="margin-top:32px">More About Me →</a>
    </div>
    <div class="about-cards">
      <div class="about-card reveal">
        <div class="ac-num">01</div>
        <h3>B.Tech — 2014</h3>
        <div class="ac-sub">Punjab Technical University</div>
        <p>Engineering foundation followed by Core and Advanced Java training at Stellar Edge Infotech.</p>
      </div>
      <div class="about-card reveal">
        <div class="ac-num">02</div>
        <h3>Senior Consultant</h3>
        <div class="ac-sub">Freelance, 2019–Present</div>
        <p>Building websites and apps for startups, founders and businesses worldwide after roles at Seasia Infotech and Smartbuzz.</p>
      </div>
      <div class="about-card reveal">
        <div class="ac-num">03</div>
        <h3>55+ Happy Clients</h3>
        <div class="ac-sub">30+ repeat clients</div>
        <p>90+ projects and 6,000+ hours delivered across WordPress, React, Twilio, Python, PHP and Magento.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ SERVICES BENTO ============ -->
<section class="section services" id="services">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Services</span>
      <h2 class="serif-title">What I Build</h2>
      <p>Full stack development across the platforms businesses rely on — built for reliability, speed and long-term scale.</p>
    </div>
    <div class="bento-grid">
      {services.map((sv, i) => (
        <a href={`/services/${sv.slug}`} class={`bento-card reveal bento-${i}`}>
          <div class="bc-num">0{i + 1}</div>
          <h3>{sv.title}</h3>
          <p>{svcBlurb[sv.slug] ?? sv.description}</p>
          {HOURLY_RATES[sv.slug] && <span class="bc-rate">${HOURLY_RATES[sv.slug]}/hr</span>}
          <span class="bc-arrow">↗</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ============ PORTFOLIO ============ -->
<section class="section portfolio" id="projects">
  <div class="wrap">
    <div class="sec-head-row reveal">
      <div>
        <span class="eyebrow">Portfolio</span>
        <h2 class="serif-title">Featured Projects</h2>
      </div>
      <a href="/portfolio" class="view-all-link">View All <svg width="14" height="14" viewBox="0 0 12 12" fill="none"><path d="M9.13125 6.75H0V5.25H9.13125L4.93125 1.05L6 0L12 6L6 12L4.93125 10.95L9.13125 6.75Z" fill="currentColor"/></svg></a>
    </div>
    <div class="proj-grid">
      {PORTFOLIO.map((pr) => (
        <article class="proj reveal">
          <div class="thumb"><span class="arrow">↗</span><img src={pr.img} alt={pr.title} loading="lazy" /></div>
          <div class="proj-body"><h3>{pr.title}</h3><div class="proj-cat">{pr.category}</div></div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============ PROCESS ============ -->
<section class="section process">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">How I Work</span>
      <h2 class="serif-title">My Process</h2>
      <p>From the first conversation to final delivery — clear and transparent every step.</p>
    </div>
    <div class="steps">
      {PROCESS.map((st, i) => (
        <div class="step reveal">
          <div class="step-num">{String(i + 1).padStart(2, '0')}</div>
          <h3>{st.title}</h3>
          <p>{st.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ STATS BAND ============ -->
<section class="band">
  <div class="wrap band-grid">
    {STATS.map((st) => (
      <div class="band-cell reveal">
        <div class="band-num" data-count={st.value.replace(/\D/g,'')} data-suffix={st.value.replace(/[\d]/g,'')}>{st.value}</div>
        <div class="band-label">{st.label}</div>
      </div>
    ))}
  </div>
</section>

<!-- ============ TESTIMONIALS ============ -->
<section class="section feedback">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Testimonials</span>
      <h2 class="serif-title">Client Feedback</h2>
    </div>
    <div class="tst-grid">
      {TESTIMONIALS.slice(0, 3).map((t) => (
        <div class="tst reveal">
          <div class="tst-quote-mark">"</div>
          <p class="quote">{t.quote}</p>
          <div class="tst-foot">
            <div class="stars">★★★★★</div>
            <div class="who-name">{t.name}</div>
            <div class="who-role">{t.meta}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ SKILLS ============ -->
<section class="section skills-sec" id="skills">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Skills</span>
      <h2 class="serif-title">Tools & Technologies</h2>
      <p>The technologies I use every day to build robust, scalable software.</p>
    </div>
    <div class="skill-cols">
      {SKILL_GROUPS.map((g) => (
        <div class="skill-card reveal">
          <div class="skill-top"><div class="sk-ic"><img src={`/icons/Icon_${g.icon}.svg`} alt="" /></div><h3>{g.title}</h3></div>
          {g.skills.map(([name, pct]) => (
            <div class="skill-row">
              <div class="skill-l"><span>{name}</span><span class="pct">{pct}%</span></div>
              <div class="bar"><i data-w={`${pct}%`}></i></div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ BLOG ============ -->
<section class="section insights">
  <div class="wrap">
    <div class="sec-head-row reveal">
      <div>
        <span class="eyebrow">Blog</span>
        <h2 class="serif-title">From the Blog</h2>
      </div>
      <a href="/blog" class="view-all-link">View All <svg width="14" height="14" viewBox="0 0 12 12" fill="none"><path d="M9.13125 6.75H0V5.25H9.13125L4.93125 1.05L6 0L12 6L6 12L4.93125 10.95L9.13125 6.75Z" fill="currentColor"/></svg></a>
    </div>
    <div class="blog-grid">
      {latest.map((p) => (
        <article class="post reveal">
          <a href={`/blog/${p.slug}`} class="post-link">
            <div class="post-thumb"><img src={p.image} alt={p.title} loading="lazy" /></div>
            <div class="post-body">
              <div class="post-meta">{formatDate(p.publishDate)} · {p.readTime}</div>
              <h3>{p.title}</h3>
              <span class="post-read">Read More →</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="section faq">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">FAQ</span>
      <h2 class="serif-title">Frequently Asked Questions</h2>
    </div>
    <div class="faq-list">
      {FAQS.slice(0, 4).map((f, i) => (
        <div class={`faq-item reveal${i === 0 ? ' open' : ''}`}>
          <button class="faq-q">{f.q} <span class="plus">+</span></button>
          <div class="faq-a"><p>{f.a}</p></div>
        </div>
      ))}
    </div>
    <div class="faq-cta reveal"><a href="/faq" class="btn btn-outline">View All FAQs →</a></div>
  </div>
</section>

<!-- ============ CONTACT CTA ============ -->
<section class="hire-cta">
  <div class="wrap">
    <div class="hire-inner reveal">
      <span class="eyebrow" style="color:var(--gold)">Ready to Start?</span>
      <h2>Let's Build Something<br><em>Exceptional Together.</em></h2>
      <p>I take on freelance and contract work and am available across time zones. Share your project — I'll send a proposal within 24 hours.</p>
      <div class="hire-btns">
        <a href="/contact" class="btn btn-dark">Start a Project →</a>
        <a href="/about" class="btn btn-hero-outline" style="border-color:rgba(255,255,255,.25);color:#fff">Learn About Me</a>
      </div>
    </div>
  </div>
</section>

<Footer />
</Layout>

<style>
/* ─── HERO ─────────────────────────────────────────────── */
.hero {
  position: relative;
  background: var(--cream);
  padding: 100px 0 60px;
  overflow: hidden;
  min-height: 92vh;
  display: flex;
  align-items: center;
}
.hero-blob {
  position: absolute;
  width: 600px; height: 600px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(185,149,64,.18) 0%, transparent 70%);
  top: -120px; right: -80px;
  pointer-events: none;
  z-index: 0;
}
.hero-blob-2 {
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(86,92,43,.12) 0%, transparent 70%);
  top: auto; bottom: -80px; right: auto; left: -60px;
}
.hero .wrap { position: relative; z-index: 2; width: 100%; }
.hero-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 60px;
  align-items: center;
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: 40px;
  padding: 8px 18px 8px 12px;
  font-size: 13px;
  font-weight: 600;
  color: var(--olive);
  margin-bottom: 28px;
  box-shadow: 0 2px 12px rgba(0,0,0,.06);
}
.avail-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: #4ade80;
  box-shadow: 0 0 0 3px rgba(74,222,128,.2);
  animation: pulse-dot 2s ease-in-out infinite;
}
@keyframes pulse-dot {
  0%, 100% { box-shadow: 0 0 0 3px rgba(74,222,128,.2); }
  50% { box-shadow: 0 0 0 6px rgba(74,222,128,.08); }
}
.h1-top {
  display: block;
  font-family: var(--body);
  font-size: clamp(14px, 1.6vw, 18px);
  font-weight: 700;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 10px;
}
.h1-main {
  display: block;
  font-family: var(--display2);
  font-weight: 800;
  font-size: clamp(64px, 8.5vw, 110px);
  line-height: .95;
  letter-spacing: -.04em;
  color: var(--ink);
  margin-bottom: 12px;
}
.h1-accent {
  display: block;
  font-family: var(--serif);
  font-style: italic;
  font-weight: 700;
  font-size: clamp(40px, 5.5vw, 72px);
  color: var(--gold);
  letter-spacing: -.02em;
  line-height: 1.1;
  margin-bottom: 28px;
}
.hero .lead {
  font-size: clamp(15px, 1.5vw, 18px);
  color: var(--ink-2);
  max-width: 480px;
  line-height: 1.75;
  margin-bottom: 36px;
}
.hero-btns { display: flex; gap: 14px; flex-wrap: wrap; }
.btn-hero-primary {
  display: inline-flex; align-items: center; gap: 9px;
  background: var(--olive); color: var(--cream-3);
  padding: 15px 28px; border-radius: 12px;
  font-weight: 700; font-size: 15px; font-family: var(--body);
  border: 2px solid var(--olive);
  transition: .25s;
}
.btn-hero-primary:hover { background: var(--olive-dark); border-color: var(--olive-dark); transform: translateY(-2px); }
.btn-hero-outline {
  display: inline-flex; align-items: center; gap: 9px;
  background: transparent; color: var(--ink);
  padding: 15px 28px; border-radius: 12px;
  font-weight: 700; font-size: 15px; font-family: var(--body);
  border: 2px solid var(--line);
  transition: .25s;
}
.btn-hero-outline:hover { border-color: var(--olive); color: var(--olive); transform: translateY(-2px); }

/* Photo */
.hero-photo { position: relative; display: flex; align-items: center; justify-content: center; }
.photo-ring {
  position: absolute;
  width: 110%; height: 110%;
  border-radius: 38% 62% 45% 55% / 42% 40% 60% 58%;
  border: 2px dashed rgba(185,149,64,.3);
  animation: morph 8s ease-in-out infinite;
  z-index: 0;
}
@keyframes morph {
  0%, 100% { border-radius: 38% 62% 45% 55% / 42% 40% 60% 58%; }
  33% { border-radius: 58% 42% 62% 38% / 54% 46% 54% 46%; }
  66% { border-radius: 42% 58% 38% 62% / 38% 58% 42% 62%; }
}
.photo-frame {
  width: 420px; height: 500px;
  border-radius: 180px 180px 120px 120px;
  overflow: hidden;
  border: 3px solid rgba(185,149,64,.35);
  box-shadow: 0 30px 80px rgba(60,54,30,.15), 0 0 0 8px rgba(185,149,64,.08);
  position: relative; z-index: 1;
  background: var(--cream-2);
}
.photo-frame img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
.photo-badge, .photo-badge-2 {
  position: absolute;
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 10px 16px;
  box-shadow: 0 8px 24px rgba(0,0,0,.1);
  z-index: 3;
  text-align: center;
}
.photo-badge { bottom: 40px; left: -20px; }
.photo-badge-2 { top: 40px; right: -20px; }
.pb-num { font-family: var(--display2); font-weight: 800; font-size: 22px; color: var(--ink); line-height: 1; }
.pb-label { font-size: 11px; color: var(--muted); font-weight: 600; letter-spacing: .04em; margin-top: 3px; }

/* Stats bar */
.stats-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: var(--white);
  border-radius: 20px;
  border: 1px solid var(--line-2);
  box-shadow: 0 8px 32px rgba(60,54,30,.07);
  margin-top: 60px;
  overflow: hidden;
}
.stat {
  padding: 28px 32px;
  border-right: 1px solid var(--line-2);
  transition: background .2s;
}
.stat:last-child { border-right: 0; }
.stat:hover { background: var(--cream); }
.stat-num {
  font-family: var(--display2);
  font-weight: 800;
  font-size: clamp(30px, 3vw, 40px);
  color: var(--ink);
  line-height: 1;
}
.stat-label { font-size: 13px; color: var(--muted); margin-top: 6px; font-weight: 500; }

/* ─── MARQUEE ──────────────────────────────────────────── */
.marquee-wrap {
  background: var(--olive);
  padding: 14px 0;
  overflow: hidden;
  white-space: nowrap;
}
.marquee-track {
  display: inline-flex;
  animation: marquee 30s linear infinite;
}
.marquee-item {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  padding: 0 36px;
  font-family: var(--display2);
  font-weight: 700;
  font-size: 15px;
  color: rgba(251,248,240,.75);
  letter-spacing: .05em;
  text-transform: uppercase;
}
.marquee-dot { color: var(--gold-2); font-size: 10px; }
@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-33.333%); }
}

/* ─── SECTION HEADERS ──────────────────────────────────── */
.sec-head {
  text-align: center;
  max-width: 600px;
  margin: 0 auto 60px;
}
.sec-head .serif-title { font-size: clamp(32px, 4.5vw, 52px); margin: 12px 0 16px; }
.sec-head p { color: var(--muted); font-size: 16px; line-height: 1.7; }
.sec-head-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 48px;
  flex-wrap: wrap;
  gap: 20px;
}
.sec-head-row .serif-title { font-size: clamp(28px, 3.8vw, 46px); margin-top: 10px; }
.view-all-link {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 14px; font-weight: 700; color: var(--olive);
  border-bottom: 1.5px solid var(--olive); padding-bottom: 2px;
  transition: opacity .2s;
}
.view-all-link:hover { opacity: .7; }

/* ─── ABOUT ────────────────────────────────────────────── */
.about { background: var(--cream-2); }
.about-layout {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 80px;
  align-items: start;
}
.about-left .serif-title {
  font-size: clamp(30px, 4vw, 48px);
  margin: 14px 0 20px;
  line-height: 1.15;
}
.about-left .serif-title em { color: var(--gold); }
.about-lead { color: var(--muted); font-size: 16px; line-height: 1.8; }
.about-cards {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}
.about-card {
  background: var(--white);
  border-radius: var(--r-md);
  padding: 28px;
  border: 1px solid var(--line-2);
  position: relative;
  transition: .25s;
  overflow: hidden;
}
.about-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 3px;
  background: var(--gold);
  border-radius: 2px 0 0 2px;
}
.about-card:hover { transform: translateX(4px); box-shadow: var(--shadow-md); }
.ac-num {
  font-family: var(--display2);
  font-weight: 800;
  font-size: 11px;
  letter-spacing: .2em;
  color: var(--gold);
  margin-bottom: 10px;
}
.about-card h3 { font-family: var(--serif); font-weight: 700; font-size: 19px; margin-bottom: 4px; }
.ac-sub { font-size: 12.5px; color: var(--olive); font-weight: 600; margin-bottom: 10px; }
.about-card p { font-size: 14px; color: var(--muted); line-height: 1.65; }

/* ─── SERVICES BENTO ───────────────────────────────────── */
.services { background: var(--cream); }
.bento-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: auto auto;
  gap: 18px;
}
.bento-0 { grid-column: 1 / 3; }
.bento-3 { grid-column: 2 / 4; }
.bento-card {
  background: var(--white);
  border-radius: var(--r-md);
  padding: 34px 32px;
  border: 1px solid var(--line-2);
  display: flex;
  flex-direction: column;
  gap: 10px;
  position: relative;
  overflow: hidden;
  transition: .3s;
  text-decoration: none;
  color: inherit;
}
.bento-card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(185,149,64,.06) 0%, transparent 60%);
  opacity: 0;
  transition: opacity .3s;
}
