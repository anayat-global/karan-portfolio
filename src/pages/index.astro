---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Karan Arora — Full Stack Developer">
<Header activePage="/" />

<!-- ============ HERO ============ -->
<section class="hero" id="home">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-text reveal">
        <span class="hero-badge"><span class="dot"></span> I Build Modern</span>
        <h1>Digital Products<br>That <span class="scale">Scale.</span></h1>
        <p class="lead">Full Stack Developer specializing in building exceptional digital experiences for the web — from pixel-perfect interfaces to resilient, scalable systems.</p>
        <div class="hero-btns">
          <a href="/projects" class="btn btn-dark">View My Work <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg></a>
          <a href="/contact" class="btn btn-outline">Let's Talk <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg></a>
        </div>
      </div>
      <div class="hero-photo reveal">
        <span class="code-chip tl">&lt;/&gt;</span>
        <span class="code-chip br">{ }</span>
        <div class="frame">
          <img src="/demo-removebg-preview.png" alt="Karan Arora" />
        </div>
      </div>
    </div>

    <div class="stats-bar reveal">
      <div class="stat">
        <div class="ic"><svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg></div>
        <div><div class="num">8+</div><div class="lab">Years Experience</div></div>
      </div>
      <div class="stat">
        <div class="ic"><svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg></div>
        <div><div class="num">60+</div><div class="lab">Projects Completed</div></div>
      </div>
      <div class="stat">
        <div class="ic"><svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg></div>
        <div><div class="num">35+</div><div class="lab">Happy Clients</div></div>
      </div>
      <div class="stat">
        <div class="ic"><svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg></div>
        <div><div class="num">100%</div><div class="lab">Client Satisfaction</div></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ TRUSTED ============ -->
<section class="trusted">
  <div class="wrap">
    <p class="cap">Trusted by industry leaders</p>
    <div class="logos reveal">
      <span>Google</span><span>Microsoft</span><span>Amazon</span><span>Adobe</span><span>Shopify</span><span>Upwork</span>
    </div>
  </div>
</section>

<!-- ============ ABOUT ============ -->
<section class="section about" id="about">
  <div class="wrap">
    <span class="eyebrow reveal">About Me</span>
    <h2 class="serif-title reveal">Crafting Digital Solutions with Engineering Excellence</h2>
    <p class="about-lead reveal">With a passion for turning complex problems into intuitive digital solutions, I leverage deep technical expertise to build products that are not just functional, but delightful to use. My approach blends engineering rigor with design sensitivity.</p>
    <div class="about-cards">
      <div class="about-card reveal">
        <div class="ic"><img src="/icons/Icon.svg" alt="" /></div>
        <h3>Masters in Software Engineering</h3>
        <div class="role">University of Technology, 2014–2016</div>
        <p>Specialized in distributed systems and performance optimization at scale.</p>
      </div>
      <div class="about-card reveal">
        <div class="ic"><img src="/icons/Icon_1.svg" alt="" /></div>
        <h3>Senior Full Stack Lead</h3>
        <div class="role">Innovation Hub Global, 2018–Present</div>
        <p>Orchestrating complex architectures for enterprise solutions and product teams.</p>
      </div>
      <div class="about-card reveal">
        <div class="ic"><img src="/icons/Icon_2.svg" alt="" /></div>
        <h3>10+ Awards Won</h3>
        <div class="role">Recognised Industry-wide</div>
        <p>Recognised for technical innovation and excellence in UX design across global platforms and hackathons.</p>
      </div>
    </div>
    <div class="resume-wrap reveal">
      <a href="#" class="btn btn-olive">Download Full Resume <img src="/icons/Icon_3.svg" alt="" /></a>
      <div class="decade">— A Decade of Excellence —</div>
    </div>
  </div>
</section>

<!-- ============ TECHNICAL ARSENAL ============ -->
<section class="section arsenal" id="skills">
  <div class="wrap">
    <div class="head reveal">
      <h2 class="serif-title">Technical Arsenal</h2>
      <p>Leveraging cutting-edge technologies to deliver robust and scalable software solutions.</p>
    </div>
    <div class="skill-cols">
      <div class="skill-card reveal">
        <div class="top"><div class="ic"><img src="/icons/Icon_4.svg" alt="" /></div><h3>Frontend Development</h3></div>
        <div class="skill-row"><div class="l"><span>React / Next.js</span><span class="pct">95%</span></div><div class="bar"><i data-w="95%"></i></div></div>
        <div class="skill-row"><div class="l"><span>TypeScript</span><span class="pct">92%</span></div><div class="bar"><i data-w="92%"></i></div></div>
        <div class="skill-row"><div class="l"><span>Tailwind CSS</span><span class="pct">98%</span></div><div class="bar"><i data-w="98%"></i></div></div>
      </div>
      <div class="skill-card reveal">
        <div class="top"><div class="ic"><img src="/icons/Icon_5.svg" alt="" /></div><h3>Backend Architecture</h3></div>
        <div class="skill-row"><div class="l"><span>Node.js / Express</span><span class="pct">92%</span></div><div class="bar"><i data-w="92%"></i></div></div>
        <div class="skill-row"><div class="l"><span>Python / Django</span><span class="pct">85%</span></div><div class="bar"><i data-w="85%"></i></div></div>
        <div class="skill-row"><div class="l"><span>PostgreSQL / MongoDB</span><span class="pct">90%</span></div><div class="bar"><i data-w="90%"></i></div></div>
      </div>
      <div class="skill-card reveal">
        <div class="top"><div class="ic"><img src="/icons/Icon_6.svg" alt="" /></div><h3>DevOps &amp; Tools</h3></div>
        <div class="skill-row"><div class="l"><span>Docker / Kubernetes</span><span class="pct">88%</span></div><div class="bar"><i data-w="88%"></i></div></div>
        <div class="skill-row"><div class="l"><span>AWS / Cloud</span><span class="pct">90%</span></div><div class="bar"><i data-w="90%"></i></div></div>
        <div class="skill-row"><div class="l"><span>Git / CI/CD</span><span class="pct">94%</span></div><div class="bar"><i data-w="94%"></i></div></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ SERVICES ============ -->
<section class="section services">
  <div class="wrap">
    <span class="eyebrow reveal">Services</span>
    <h2 class="serif-title reveal">Solutions I Provide</h2>
    <p class="sub reveal">End-to-end expertise across the modern web, engineered for reliability, speed and long-term scale.</p>
    <div class="svc-grid">
      <div class="svc-card reveal"><div class="ic"><img src="/icons/Icon_7.svg" alt="" /></div><h3>Frontend Engineering</h3><p>Pixel-perfect, high-performance interfaces built with modern React frameworks and clean Tailwind CSS.</p></div>
      <div class="svc-card reveal"><div class="ic"><img src="/icons/Icon_8.svg" alt="" /></div><h3>Full Stack Systems</h3><p>End-to-end development focusing on robust backends, scalable APIs and seamless database integration.</p></div>
      <div class="svc-card reveal"><div class="ic"><img src="/icons/Icon_9.svg" alt="" /></div><h3>UI/UX Strategy</h3><p>Informed design decisions based on user behaviour analysis and accessibility standards for global reach.</p></div>
      <div class="svc-card reveal"><div class="ic"><img src="/icons/Icon_12.svg" alt="" /></div><h3>Performance Audit</h3><p>Optimising core web vitals to ensure lightning-fast load times and superior SEO rankings for your app.</p></div>
      <div class="svc-card reveal"><div class="ic"><img src="/icons/Icon_10.svg" alt="" /></div><h3>API Development</h3><p>Designing and implementing RESTful and GraphQL APIs that are secure, documented and easy to consume.</p></div>
      <div class="svc-card reveal"><div class="ic"><img src="/icons/Icon_11.svg" alt="" /></div><h3>Legacy Modernization</h3><p>Migrating outdated tech stacks to modern architectures without downtime, ensuring longevity and scale.</p></div>
    </div>
  </div>
</section>

<!-- ============ PORTFOLIO ============ -->
<section class="section portfolio" id="projects">
  <div class="wrap">
    <div class="head reveal">
      <div>
        <span class="eyebrow">Portfolio</span>
        <h2 class="serif-title">Featured Projects</h2>
      </div>
      <div class="filters" id="filters">
        <button class="active" data-f="all">All</button>
        <button data-f="web">Web-Apps</button>
        <button data-f="mobile">Mobile</button>
      </div>
    </div>
    <div class="proj-grid" id="projGrid">
      <article class="proj reveal" data-cat="web">
        <div class="thumb"><span class="arrow">↗</span><img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=700&q=80&auto=format&fit=crop" alt="LuxeFinance Dashboard" /></div>
        <div class="body"><h3>LuxeFinance Dashboard</h3><div class="tags">Next.js · Tailwind · Chart.js</div></div>
      </article>
      <article class="proj reveal" data-cat="web">
        <div class="thumb"><span class="arrow">↗</span><img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=700&q=80&auto=format&fit=crop" alt="ChronoLuxury Boutique" /></div>
        <div class="body"><h3>ChronoLuxury Boutique</h3><div class="tags">Shopify · React · Framer Motion</div></div>
      </article>
      <article class="proj reveal" data-cat="mobile">
        <div class="thumb"><span class="arrow">↗</span><img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=700&q=80&auto=format&fit=crop" alt="MedConnect Pro" /></div>
        <div class="body"><h3>MedConnect Pro</h3><div class="tags">Python · Django · React Native</div></div>
      </article>
    </div>
    <div class="view-all-wrap reveal">
      <a href="/projects" class="btn btn-outline">View All Projects →</a>
    </div>
  </div>
</section>

<!-- ============ PROCESS ============ -->
<section class="section process">
  <div class="wrap">
    <span class="eyebrow reveal">How I Work</span>
    <h2 class="serif-title reveal">Working Process</h2>
    <p class="sub reveal">A disciplined, transparent workflow that turns ideas into shipped, performant products.</p>
    <div class="steps">
      <div class="step reveal"><div class="circle">01</div><h3>Discover</h3><p>In-depth research and stakeholder interviews to align on business goals.</p></div>
      <div class="step reveal"><div class="circle">02</div><h3>Design</h3><p>Low-fidelity wireframes leading to high-fidelity interactive prototypes.</p></div>
      <div class="step reveal"><div class="circle">03</div><h3>Develop</h3><p>Clean, scalable code implementation using modern technology stacks.</p></div>
      <div class="step reveal"><div class="circle">04</div><h3>Launch</h3><p>Deployment, thorough testing and ongoing performance optimization.</p></div>
    </div>
  </div>
</section>

<!-- ============ TESTIMONIALS ============ -->
<section class="section feedback" id="experience">
  <div class="wrap">
    <span class="eyebrow reveal">Testimonials</span>
    <h2 class="serif-title reveal">Client Feedback</h2>
    <div class="tst-grid">
      <div class="tst reveal">
        <div class="stars">★★★★★</div>
        <p class="quote">"Karan's ability to translate complex business requirements into sleek, high-performing code is unmatched. He delivered our project ahead of schedule and exceeded all expectations."</p>
        <div class="who"><img src="https://i.pravatar.cc/46?img=44" alt="Sarah Jenkins" /><div><div class="n">Sarah Jenkins</div><div class="r">CTO, TechFlowers</div></div></div>
      </div>
      <div class="tst reveal">
        <div class="stars">★★★★★</div>
        <p class="quote">"The UI/UX strategy Karan implemented for our retail platform saw a 35% increase in conversion within the first month. An absolute expert in both design and development."</p>
        <div class="who"><img src="https://i.pravatar.cc/46?img=32" alt="Michael Chen" /><div><div class="n">Michael Chen</div><div class="r">Marketing Director, GlobalShop</div></div></div>
      </div>
      <div class="tst reveal">
        <div class="stars">★★★★★</div>
        <p class="quote">"Technically brilliant and a great communicator. Karan made the entire development process transparent and stress-free. Highly recommended for any serious product development."</p>
        <div class="who"><img src="https://i.pravatar.cc/46?img=68" alt="Emma Rodriguez" /><div><div class="n">Emma Rodriguez</div><div class="r">Founder, WellnessApp</div></div></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ STATS BAND ============ -->
<section class="band">
  <div class="wrap band-grid">
    <div class="cell reveal"><div class="big">120+</div><div class="lab">Projects Delivered</div></div>
    <div class="cell reveal"><div class="big">10</div><div class="lab">Years Experience</div></div>
    <div class="cell reveal"><div class="big">45</div><div class="lab">Global Clients</div></div>
    <div class="cell reveal"><div class="big">2.5k</div><div class="lab">Cups of Coffee</div></div>
  </div>
</section>

<!-- ============ INSIGHTS ============ -->
<section class="section insights">
  <div class="wrap">
    <div class="head reveal">
      <h2 class="serif-title">Technical Insights</h2>
      <a href="/blog" class="view-all">View All Articles <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M9.13125 6.75H0V5.25H9.13125L4.93125 1.05L6 0L12 6L6 12L4.93125 10.95L9.13125 6.75Z" fill="currentColor"/></svg></a>
    </div>
    <div class="blog-grid">
      <article class="post reveal">
        <div class="thumb"><img src="https://images.unsplash.com/photo-1518770660439-4636190af475?w=700&q=80&auto=format&fit=crop" alt="Optimizing React" /></div>
        <div class="body"><div class="meta">May 12, 2024 · 8 Min Read</div><h3>Optimizing React for Enterprise Scale</h3><a class="read" href="/blog/optimizing-react">Read More <img src="/icons/Icon_17.svg" alt="" /></a></div>
      </article>
      <article class="post reveal">
        <div class="thumb"><img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=700&q=80&auto=format&fit=crop" alt="Microservices" /></div>
        <div class="body"><div class="meta">April 28, 2024 · 6 Min Read</div><h3>Microservices vs Monoliths in 2024</h3><a class="read" href="/blog/microservices-vs-monoliths">Read More <img src="/icons/Icon_17.svg" alt="" /></a></div>
      </article>
      <article class="post reveal">
        <div class="thumb"><img src="https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?w=700&q=80&auto=format&fit=crop" alt="AI in web dev" /></div>
        <div class="body"><div class="meta">March 15, 2024 · 10 Min Read</div><h3>The Future of AI in Web Development</h3><a class="read" href="/blog/ai-in-web-development">Read More <img src="/icons/Icon_17.svg" alt="" /></a></div>
      </article>
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="section faq">
  <div class="wrap">
    <span class="eyebrow reveal">FAQ</span>
    <h2 class="serif-title reveal">Frequently Asked Questions</h2>
    <div class="faq-list">
      <div class="faq-item open reveal">
        <button class="faq-q">Do you work with startups or large corporations? <span class="plus">+</span></button>
        <div class="faq-a"><p>I enjoy working with both. Startups allow for high agility and innovation, while corporate projects offer opportunities for large-scale engineering and strict compliance work. I tailor my approach to suit the unique needs of each.</p></div>
      </div>
      <div class="faq-item reveal">
        <button class="faq-q">What is your typical project timeline? <span class="plus">+</span></button>
        <div class="faq-a"><p>Timelines vary by scope, but most focused builds run four to twelve weeks. After a discovery call I provide a detailed milestone plan so you always know what ships and when.</p></div>
      </div>
      <div class="faq-item reveal">
        <button class="faq-q">Do you offer post-launch maintenance? <span class="plus">+</span></button>
        <div class="faq-a"><p>Yes. I offer flexible retainer and support packages covering monitoring, updates, performance tuning and new feature development so your product keeps evolving after launch.</p></div>
      </div>
    </div>
    <div style="text-align:center;margin-top:32px"><a href="/faq" class="btn btn-outline">View All FAQs →</a></div>
  </div>
</section>

<!-- ============ CONTACT CTA ============ -->
<section class="cta">
  <div class="wrap">
    <h2>Ready to Build Something <em>Exceptional?</em></h2>
    <p>Let's collaborate on your next project. I'm available for freelance, contract, and full-time opportunities.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap">
      <a href="/contact" class="btn btn-cream">Start a Project</a>
      <a href="/about" class="btn" style="color:var(--cream-3);border-color:rgba(255,255,255,.3)">Learn About Me →</a>
    </div>
  </div>
</section>

<Footer />
</Layout>

<style>
/* HERO */
.hero {
  position: relative;
  background-image: url('/plan.png');
  padding: 64px 0 40px;
  background-repeat: no-repeat;
  width: 100%;
  background-size: cover;
}
.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: repeating-radial-gradient(circle at 78% 60%, transparent 0 38px, rgba(86,92,43,.045) 38px 39px);
  opacity: .6;
  pointer-events: none;
}
.hero-grid {
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  gap: 40px;
  align-items: center;
  position: relative;
  z-index: 2;
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--olive);
  margin-bottom: 22px;
  position: relative;
}
.hero-badge::before {
  content: "";
  width: 56px;
  height: 2px;
  background: rgb(193 155 82);
  border-radius: 2px;
  bottom: -3px;
  position: absolute;
}
.hero-badge .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); }
.hero h1 {
  font-family: "Bebas Neue", sans-serif;
  font-weight: 700;
  font-size: clamp(42px, 6vw, 60px);
  line-height: 1.02;
  letter-spacing: -.02em;
  text-transform: uppercase;
  color: var(--ink);
  margin-bottom: 24px;
}
.hero h1 .scale {
  font-family: var(--serif);
  font-style: italic;
  font-weight: 600;
  text-transform: none;
  color: var(--gold);
  letter-spacing: -.01em;
  font-size: 70px;
}
.hero p.lead { font-size: 20px; color: #373633; max-width: 440px; margin-bottom: 30px; }
.hero-btns { display: flex; gap: 14px; flex-wrap: wrap; }
.hero-photo { position: relative; }
.hero-photo .frame::before {
  content: '';
  position: absolute;
  border-radius: 100%;
  box-shadow: var(--shadow-lg);
  border: 3px solid rgb(193 155 82 / 37%);
  aspect-ratio: 3/3;
  background: rgb(195 176 137 / 53%);
  width: 100%;
  z-index: -2;
}
.hero-photo .frame { position: relative; }
.hero-photo .frame img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
.hero-photo .frame::after {
  content: "";
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 150px;
  background: linear-gradient(to bottom, transparent 0%, rgba(247,241,229,.35) 35%, rgba(247,241,229,.8) 75%, #f7f1e5 100%);
  z-index: 2;
}
.hero-photo::after {
  content: "";
  position: absolute;
  inset: -30px -22px auto auto;
  width: 230px; height: 230px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(185,149,64,.28), transparent 70%);
  z-index: -1;
}
.code-chip { position: absolute; font-family: var(--display); font-weight: 800; color: var(--gold); font-size: 22px; opacity: .7; }
.code-chip.tl { top: 6px; left: -10px; }
.code-chip.br { bottom: 20px; right: -6px; }

/* STATS BAR */
.stats-bar {
  margin-top: 0;
  background: var(--white);
  border-radius: 20px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 2rem;
  box-shadow: 0 10px 30px rgba(0,0,0,.05);
  position: relative;
  z-index: 3;
}
.stat { display: flex; align-items: center; gap: 14px; padding: 6px 22px; border-right: 1.5px solid var(--line-2); }
.stat:last-child { border-right: 0; }
.stat .ic { width: 70px; height: 70px; border-radius: 50px; flex: none; background: #f8ebca; display: grid; place-items: center; color: var(--olive); }
.stat .ic svg { max-width: 32px; width: 100%; color: rgb(199 158 78); }
.stat .num { font-family: var(--display); font-weight: 800; font-size: 28px; color: var(--ink); line-height: 1; }
.stat .lab { font-size: 14px; color: var(--muted); margin-top: 3px; }

/* TRUSTED */
.trusted { background: var(--cream); padding: 44px 0 8px; }
.trusted .cap { text-align: center; font-size: 12px; letter-spacing: .24em; text-transform: uppercase; color: var(--muted); font-weight: 600; margin-bottom: 26px; }
.logos { display: flex; align-items: center; justify-content: center; gap: 56px; flex-wrap: wrap; }
.logos span { font-family: var(--serif); font-weight: 600; font-size: 26px; color: #B4AC98; transition: color .25s; }
.logos span:hover { color: var(--olive); }

/* ABOUT */
.about { background: var(--cream-2); text-align: center; }
.about .serif-title { font-size: clamp(32px, 4.4vw, 52px); margin: 16px auto 0; max-width: 720px; }
.about-lead { max-width: 640px; margin: 26px auto 0; color: var(--muted); font-size: 16px; }
.about-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 52px; text-align: left; }
.about-card { background: var(--white); border-radius: var(--r-md); padding: 30px 28px; border: 1px solid var(--line-2); box-shadow: var(--shadow-sm); transition: .25s; }
