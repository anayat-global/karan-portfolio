---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const sections = [
  { id: "section-1", title: "Engagement & Scope", content: `These Terms of Engagement govern all freelance, contract, and consulting work performed by Karan Arora ("the Developer") for clients ("the Client"). By initiating an engagement, the Client agrees to these terms.\n\nAll projects begin with a written scope of work agreed by both parties. Any work outside the defined scope will be discussed and priced separately before commencement. Verbal agreements do not constitute a change to the agreed scope.` },
  { id: "section-2", title: "Payment Terms", content: `Standard payment terms are 50% deposit before work begins, with the remaining 50% due upon delivery of the final deliverable. For longer engagements (8+ weeks), milestone-based payments are structured into the project plan.\n\nAll invoices are payable within 14 days of issue. Late payments are subject to a 1.5% monthly interest charge. The Developer reserves the right to pause work if invoices remain unpaid beyond 30 days.` },
  { id: "section-3", title: "Intellectual Property", content: `Upon receipt of full payment, all work product created by the Developer for the Client becomes the sole intellectual property of the Client. This includes source code, designs, documentation, and any other deliverables specifically created for the project.\n\nThe Developer retains the right to display and reference completed work in their portfolio. The Developer also retains ownership of all pre-existing code libraries, frameworks, utilities, and tools used in the work, which are licensed to the Client on a non-exclusive, perpetual basis.` },
  { id: "section-4", title: "Confidentiality", content: `The Developer agrees to treat all Client information as strictly confidential. This includes business plans, technical architecture, user data, and any other proprietary information shared during the engagement. This obligation survives the termination of the engagement.\n\nThe Developer will not disclose confidential information to third parties without prior written consent from the Client, except as required by law.` },
  { id: "section-5", title: "Revisions & Warranties", content: `Each project milestone includes one round of revisions within the agreed scope. Additional revision rounds are billed at the standard hourly rate.\n\nThe Developer warrants that all work will be delivered to a professional standard and will function as specified in the scope document. The Developer does not warrant that the work will be completely error-free, but will remedy any material defects reported within 30 days of delivery at no additional charge.` },
  { id: "section-6", title: "Termination", content: `Either party may terminate the engagement with 14 days' written notice. Upon termination, the Client is liable for payment of all work completed up to the termination date, calculated at the agreed project or hourly rate.\n\nIf the Client terminates without cause after the project is more than 50% complete, the full project fee becomes payable. The Developer will deliver all completed work to the Client upon receipt of final payment.` },
];
---

<Layout title="Terms of Engagement — Karan Arora" description="Terms and conditions governing freelance and contract work by Karan Arora.">
<Header />

<!-- HERO -->
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Legal</span>
    <h1>Terms of<br>Engagement</h1>
    <p>The conditions that govern all freelance and contract work. Last updated: January 2024.</p>
  </div>
</section>

<!-- CONTENT -->
<section class="section legal-section">
  <div class="wrap legal-layout">
    <!-- TOC -->
    <aside class="legal-toc">
      <div class="toc-card">
        <div class="toc-label">Contents</div>
        <nav class="toc">
          {sections.map(s => (
            <a href={`#${s.id}`} class="toc-link">{s.title}</a>
          ))}
        </nav>
      </div>
    </aside>

    <!-- ARTICLE -->
    <article class="legal-body">
      {sections.map(s => (
        <section id={s.id} class="legal-section-block reveal">
          <h2>{s.title}</h2>
          {s.content.split('\n\n').map(para => <p>{para}</p>)}
        </section>
      ))}

      <div class="legal-footer reveal">
        <p>For questions about these terms, please <a href="/contact">get in touch</a>. These terms are governed by the laws of England and Wales.</p>
      </div>
    </article>
  </div>
</section>

<Footer />
</Layout>

<style>
.legal-section { background: var(--cream); }
.legal-layout { display: grid; grid-template-columns: 220px 1fr; gap: 60px; align-items: start; }
.legal-toc { position: sticky; top: 94px; }
.toc-card { background: var(--white); border: 1px solid var(--line-2); border-radius: var(--r-md); padding: 24px; box-shadow: var(--shadow-sm); }
.toc-label { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; font-weight: 700; color: var(--muted); margin-bottom: 16px; }
.toc { display: flex; flex-direction: column; gap: 4px; }
.toc-link { font-size: 13.5px; color: var(--muted); font-weight: 500; padding: 6px 10px; border-radius: 6px; transition: .2s; border-left: 2px solid transparent; }
.toc-link:hover { color: var(--ink); background: var(--cream-2); border-left-color: var(--gold); }

.legal-body { max-width: 740px; }
.legal-section-block { border-bottom: 1px solid var(--line-2); padding-bottom: 40px; margin-bottom: 40px; }
.legal-section-block:last-of-type { border-bottom: 0; }
.legal-section-block h2 { font-family: var(--serif); font-size: 26px; font-weight: 700; color: var(--ink); margin-bottom: 18px; }
.legal-section-block p { font-size: 15px; color: var(--muted); line-height: 1.85; margin-bottom: 16px; }
.legal-footer { background: var(--cream-2); border-radius: var(--r-md); padding: 22px 28px; border: 1px solid var(--line-2); }
.legal-footer p { font-size: 14px; color: var(--muted); margin: 0; }
.legal-footer a { color: var(--olive); font-weight: 600; }

@media (max-width: 980px) {
  .legal-layout { grid-template-columns: 1fr; }
  .legal-toc { position: static; }
}
</style>
