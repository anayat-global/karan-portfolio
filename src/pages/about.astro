---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About — Karan Arora" description="Learn about Karan Arora — Full Stack Developer, Systems Architect, and design-minded engineer.">
<Header activePage="/about" />

<!-- HERO -->
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow reveal">About Me</span>
    <h1 class="reveal">Architect of<br>Digital Experiences</h1>
    <p class="reveal">A design-minded engineer who bridges structural precision with aesthetic intentionality — building products that are both technically rigorous and delightful to use.</p>
  </div>
</section>

<!-- INTRO SPLIT -->
<section class="section intro-split">
  <div class="wrap intro-grid">
    <div class="intro-label reveal">
      <span class="eyebrow">The Engineer</span>
    </div>
    <div class="intro-body">
      <h2 class="serif-title reveal">I don't just write code.<br>I craft digital architecture.</h2>
      <p class="reveal">With over 8 years building full-stack systems, I've developed an obsession with the intersection where engineering meets design. Every project I take on is a chance to build something that performs as beautifully as it looks — from a 50ms API response to a micro-interaction that delights a user at 3am.</p>
      <p class="reveal" style="margin-top:18px">My work spans fintech dashboards, e-commerce platforms, healthcare systems, and developer tooling. What unites them is a relentless focus on craft, clarity, and longevity.</p>
    </div>
  </div>
</section>

<!-- EXPERIENCE TIMELINE -->
<section class="section exp-section">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Experience</span>
      <h2 class="serif-title">Career Timeline</h2>
    </div>
    <div class="timeline">
      <article class="timeline-item reveal">
        <div class="tl-meta">
          <span class="tl-year">2021–Present</span>
          <span class="tl-tag">Full-Time</span>
        </div>
        <div class="tl-body">
          <h3>Principal Full Stack Engineer</h3>
          <div class="tl-company">Meridian Technologies, London</div>
          <p>Leading a team of 12 engineers building a next-generation fintech infrastructure serving 2M+ daily users. Drove a 40% performance improvement across core APIs and introduced a component design system adopted company-wide.</p>
          <div class="tl-stack">React · Node.js · Kubernetes · PostgreSQL · TypeScript</div>
        </div>
      </article>
      <article class="timeline-item reveal">
        <div class="tl-meta">
          <span class="tl-year">2018–2021</span>
          <span class="tl-tag">Full-Time</span>
        </div>
        <div class="tl-body">
          <h3>Senior Full Stack Lead</h3>
          <div class="tl-company">Innovation Hub Global, Toronto</div>
          <p>Architected and delivered 30+ client products across healthcare, retail, and SaaS verticals. Established engineering best practices, mentored junior engineers, and owned end-to-end delivery for flagship clients.</p>
          <div class="tl-stack">Next.js · Python · AWS · MongoDB · Docker</div>
        </div>
      </article>
      <article class="timeline-item reveal">
        <div class="tl-meta">
          <span class="tl-year">2016–2018</span>
          <span class="tl-tag">Full-Time</span>
        </div>
        <div class="tl-body">
          <h3>Full Stack Developer</h3>
          <div class="tl-company">Vertex Labs, San Francisco</div>
          <p>Built scalable web applications for early-stage startups. Specialised in rapid prototyping, performance optimisation, and translating complex UX designs into pixel-perfect implementations.</p>
          <div class="tl-stack">Vue.js · Express · GraphQL · Redis · CI/CD</div>
        </div>
      </article>
      <article class="timeline-item reveal">
        <div class="tl-meta">
          <span class="tl-year">2014–2016</span>
          <span class="tl-tag">Education</span>
        </div>
        <div class="tl-body">
          <h3>MSc Software Engineering</h3>
          <div class="tl-company">University of Technology, Sydney</div>
          <p>Specialised in distributed systems, performance engineering, and human-computer interaction. Graduated with Distinction. Thesis on adaptive load-balancing in microservice architectures.</p>
          <div class="tl-stack">Distributed Systems · HCI · Performance Engineering</div>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- PHILOSOPHY -->
<section class="section philosophy">
  <div class="wrap">
    <div class="phil-grid">
      <div class="phil-text reveal">
        <span class="eyebrow">Philosophy</span>
        <h2 class="serif-title">Engineering is a craft,<br>not just a job.</h2>
        <p>I believe the best digital products are built at the intersection of deep technical knowledge and genuine empathy for users. Speed matters. Clarity matters. Longevity matters.</p>
        <p style="margin-top:16px">When I'm not architecting systems, I'm writing about engineering practices, contributing to open-source, or mentoring developers earlier in their journey.</p>
        <a href="/contact" class="btn btn-olive" style="margin-top:32px;display:inline-flex">Work With Me →</a>
      </div>
      <div class="phil-stats reveal">
        <div class="pstat"><div class="pnum">120+</div><div class="plab">Projects Shipped</div></div>
        <div class="pstat"><div class="pnum">8+</div><div class="plab">Years of Experience</div></div>
        <div class="pstat"><div class="pnum">45</div><div class="plab">Happy Clients</div></div>
        <div class="pstat"><div class="pnum">3</div><div class="plab">Continents Served</div></div>
      </div>
    </div>
  </div>
</section>

<!-- SKILLS OVERVIEW -->
<section class="section skills-overview">
  <div class="wrap">
    <div class="section-head center reveal">
      <span class="eyebrow">Capabilities</span>
      <h2 class="serif-title">What I Bring to the Table</h2>
    </div>
    <div class="caps-grid">
      <div class="cap-card reveal">
        <div class="cap-icon"><img src="/icons/Icon_4.svg" alt="" /></div>
        <h3>Frontend Architecture</h3>
        <p>React, Next.js, TypeScript, Tailwind CSS. I build interfaces that load fast, feel native, and scale with the team.</p>
      </div>
      <div class="cap-card reveal">
        <div class="cap-icon"><img src="/icons/Icon_5.svg" alt="" /></div>
        <h3>Backend Systems</h3>
        <p>Node.js, Python, PostgreSQL, Redis. I design backends that handle millions of requests without breaking a sweat.</p>
      </div>
      <div class="cap-card reveal">
        <div class="cap-icon"><img src="/icons/Icon_6.svg" alt="" /></div>
        <h3>DevOps & Cloud</h3>
        <p>Docker, Kubernetes, AWS, CI/CD. I own the full deployment lifecycle, from container to production.</p>
      </div>
      <div class="cap-card reveal">
        <div class="cap-icon"><img src="/icons/Icon_9.svg" alt="" /></div>
        <h3>UI/UX Strategy</h3>
        <p>I bridge engineering and design — translating Figma mocks into pixel-perfect, accessible, responsive UIs.</p>
      </div>
      <div class="cap-card reveal">
        <div class="cap-icon"><img src="/icons/Icon_8.svg" alt="" /></div>
        <h3>API Design</h3>
        <p>RESTful and GraphQL APIs built with documentation-first thinking, versioning, and security baked in.</p>
      </div>
      <div class="cap-card reveal">
        <div class="cap-icon"><img src="/icons/Icon_11.svg" alt="" /></div>
        <h3>Tech Leadership</h3>
        <p>Mentorship, code review culture, architecture decisions, and engineering process — I've led teams of up to 15.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="about-cta">
  <div class="wrap" style="text-align:center">
    <span class="eyebrow" style="color:var(--gold)">Let's Connect</span>
    <h2 class="serif-title reveal" style="font-size:clamp(30px,4vw,48px);color:var(--cream-3);margin-top:14px">Ready to work together?</h2>
    <p class="reveal" style="color:rgba(251,248,240,.65);max-width:480px;margin:20px auto 36px;font-size:16px">I'm selective about the projects I take on — so if we're a fit, let's make something worth building.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap">
      <a href="/contact" class="btn btn-cream reveal">Start a Conversation</a>
      <a href="/projects" class="btn btn-outline-light reveal">See My Work →</a>
    </div>
  </div>
</section>

<Footer />
</Layout>

<style>
.intro-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 60px; align-items: start; }
.intro-label { padding-top: 6px; }
.intro-body .serif-title { font-size: clamp(28px, 3.5vw, 42px); }
.intro-body p { color: var(--muted); font-size: 16px; line-height: 1.8; margin-top: 24px; }

/* EXPERIENCE */
.exp-section { background: var(--cream-2); }
.section-head { margin-bottom: 56px; }
.section-head .serif-title { font-size: clamp(28px, 3.5vw, 42px); margin-top: 10px; }
.timeline { display: flex; flex-direction: column; gap: 0; }
.timeline-item { display: grid; grid-template-columns: 200px 1fr; gap: 40px; padding: 40px 0; border-bottom: 1px solid var(--line-2); }
.timeline-item:last-child { border-bottom: 0; }
.tl-meta { padding-top: 4px; }
.tl-year { display: block; font-family: var(--display); font-weight: 800; font-size: 15px; color: var(--ink); }
.tl-tag { display: inline-block; margin-top: 8px; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: var(--olive); background: rgba(86,92,43,.1); padding: 3px 10px; border-radius: 20px; }
.tl-body h3 { font-family: var(--serif); font-weight: 700; font-size: 22px; color: var(--ink); margin-bottom: 4px; }
.tl-company { font-size: 13px; color: var(--gold); font-weight: 600; letter-spacing: .06em; margin-bottom: 14px; }
.tl-body p { font-size: 15px; color: var(--muted); line-height: 1.75; }
.tl-stack { margin-top: 16px; font-size: 12px; font-family: 'Courier New', monospace; color: var(--olive-2); letter-spacing: .04em; }

/* PHILOSOPHY */
.philosophy { background: var(--cream); }
.phil-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
.phil-text .serif-title { font-size: clamp(28px, 3.5vw, 42px); margin-top: 14px; }
.phil-text p { color: var(--muted); font-size: 16px; line-height: 1.8; margin-top: 20px; }
.phil-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
.pstat { background: var(--cream-2); border: 1px solid var(--line-2); border-radius: var(--r-md); padding: 28px 24px; text-align: center; }
.pnum { font-family: var(--display); font-weight: 800; font-size: 42px; color: var(--olive); line-height: 1; }
.plab { font-size: 13px; color: var(--muted); margin-top: 8px; font-weight: 500; }

/* CAPABILITIES */
.skills-overview { background: var(--cream-2); }
.caps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 52px; }
.cap-card { background: var(--white); border-radius: var(--r-md); padding: 30px 28px; border: 1px solid var(--line-2); box-shadow: var(--shadow-sm); transition: .25s; }
.cap-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }
.cap-icon { width: 52px; height: 52px; border-radius: 14px; background: rgba(86,92,43,.1); display: grid; place-items: center; margin-bottom: 18px; }
.cap-card h3 { font-family: var(--serif); font-weight: 700; font-size: 19px; margin-bottom: 10px; }
.cap-card p { font-size: 14px; color: var(--muted); line-height: 1.7; }

/* ABOUT CTA */
.about-cta { background: var(--olive-dark); padding: 96px 0; }
.btn-outline-light { background: transparent; color: var(--cream-3); border: 1.5px solid rgba(251,248,240,.3); border-radius: 10px; font-size: 16px; }
.btn-outline-light:hover { background: rgba(255,255,255,.1); }

@media (max-width: 980px) {
  .intro-grid { grid-template-columns: 1fr; gap: 24px; }
  .timeline-item { grid-template-columns: 1fr; gap: 12px; }
  .phil-grid { grid-template-columns: 1fr; gap: 48px; }
  .caps-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .caps-grid { grid-template-columns: 1fr; }
  .phil-stats { grid-template-columns: 1fr 1fr; }
}
</style>
