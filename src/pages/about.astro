---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, EXPERIENCE, EDUCATION, SKILLS, STATS } from '../data/site';
const timeline = [
  { year: 'Oct 2019 – Present', tag: 'Freelance', title: 'Senior Consultant', company: 'Independent, Upwork & direct clients', text: 'Building websites and web applications for startups, sole founders and businesses across the world. Full stack and MERN stack delivery from consulting and development through launch and support.', stack: 'WordPress · React JS · Twilio · Python · PHP · Magento' },
  { year: 'May 2017 – Oct 2019', tag: 'Full-Time', title: 'Consultant', company: 'Seasia Infotech', text: 'Consulting and delivery of web solutions for client projects.', stack: '' },
  { year: 'Oct 2014 – Apr 2017', tag: 'Full-Time', title: 'Web Developer', company: 'Smartbuzz', text: 'Started my career building websites and web applications.', stack: '' },
  { year: '2010 – 2014', tag: 'Education', title: 'B.Tech', company: 'Punjab Technical University', text: 'Engineering degree. Added Core Java and Advanced Java training at Stellar Edge Infotech in 2013.', stack: '' },
];
---


<Layout title="About Karandeep Arora | Freelance Full Stack Developer in India" description="Karandeep Arora is a freelance full stack and MERN stack developer in India with 10 years of experience, 90+ projects and 55+ happy clients worldwide.">
<Header activePage="/about" />

<!-- HERO -->
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow reveal">About Me</span>
    <h1 class="reveal">Freelance Full<br>Stack Developer</h1>
    <p class="reveal">Based in India, building cost-effective, customised and scalable web solutions for clients around the world for nearly 10 years.</p>
  </div>
</section>

<!-- INTRO SPLIT -->
<section class="section intro-split">
  <div class="wrap intro-grid">
    <div class="intro-label reveal">
      <span class="eyebrow">Hello, I'm Karandeep</span>
    </div>
    <div class="intro-body">
      <h2 class="serif-title reveal">I build websites and apps that<br>fit your budget and your goals.</h2>
      <p class="reveal">I am an expert freelance full stack developer and MERN stack developer with nearly 10 years of experience in WordPress website development and other leading web technologies. By focusing on complex customer requirements, I make sure your project is executed well, from consulting and ideation through development and launch.</p>
      <p class="reveal" style="margin-top:18px">I have helped companies, sole founders and businesses from Australia, the United States, the United Kingdom, Canada, Japan, Italy, India, Saudi Arabia and South Africa, working with clients and remote development teams across time zones. I will make sure your site or app is well designed, tailored to your needs and fully responsive on every device.</p>
    </div>
  </div>
</section>

<!-- EXPERIENCE TIMELINE -->
<section class="section exp-section">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Experience</span>
      <h2 class="serif-title">Career Timeline</h2>
    </div>
    <div class="timeline">
      {timeline.map((t) => (
      <article class="timeline-item reveal">
        <div class="tl-meta">
          <span class="tl-year">{t.year}</span>
          <span class="tl-tag">{t.tag}</span>
        </div>
        <div class="tl-body">
          <h3>{t.title}</h3>
          <div class="tl-company">{t.company}</div>
          <p>{t.text}</p>
          {t.stack && <div class="tl-stack">{t.stack}</div>}
        </div>
      </article>
      ))}
    </div>
  </div>
</section>

<!-- PHILOSOPHY -->
<section class="section philosophy">
  <div class="wrap">
    <div class="phil-grid">
      <div class="phil-text reveal">
        <span class="eyebrow">Why Work With Me</span>
        <h2 class="serif-title">Clean code, clear<br>communication.</h2>
        <p>From consulting and ideation to development and launch, I handle your project with clean coding, innovation and commitment. I keep everything transparent, share updates on every stage of development, and talk to you through the apps and platforms you like.</p>
        <p style="margin-top:16px">I am comfortable taking calls with international clients and can arrange an interview to discuss your project. You can also review my work history on Upwork before hiring me.</p>
        <a href="/contact" class="btn btn-olive" style="margin-top:32px;display:inline-flex">Work With Me →</a>
      </div>
      <div class="phil-stats reveal">
        {STATS.map((st) => (
        <div class="pstat"><div class="pnum">{st.value}</div><div class="plab">{st.label}</div></div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- SKILLS OVERVIEW -->
<section class="section skills-overview">
  <div class="wrap">
    <div class="section-head center reveal">
      <span class="eyebrow">Capabilities</span>
      <h2 class="serif-title">What I Bring to the Table</h2>
    </div>
    <div class="caps-grid">
      <div class="cap-card reveal">
        <div class="cap-icon"><img src="/icons/Icon_4.svg" alt="" /></div>
        <h3>WordPress Development</h3>
        <p>Custom themes, plugins, WooCommerce stores, migrations, speed and security.</p>
      </div>
      <div class="cap-card reveal">
        <div class="cap-icon"><img src="/icons/Icon_5.svg" alt="" /></div>
        <h3>React JS & React Native</h3>
        <p>Interactive, scalable web and mobile apps with React, plus AngularJS, VueJS and Redux.</p>
      </div>
      <div class="cap-card reveal">
        <div class="cap-icon"><img src="/icons/Icon_6.svg" alt="" /></div>
        <h3>Twilio Development</h3>
        <p>SMS, voice, audio and video, Flex and Studio integrations for customer communication.</p>
      </div>
      <div class="cap-card reveal">
        <div class="cap-icon"><img src="/icons/Icon_9.svg" alt="" /></div>
        <h3>Magento Development</h3>
        <p>Custom Magento stores, themes, migrations and performance optimisation.</p>
      </div>
      <div class="cap-card reveal">
        <div class="cap-icon"><img src="/icons/Icon_8.svg" alt="" /></div>
        <h3>Payment & API Integration</h3>
        <p>Payment gateways and third-party API integrations that connect your systems.</p>
      </div>
      <div class="cap-card reveal">
        <div class="cap-icon"><img src="/icons/Icon_11.svg" alt="" /></div>
        <h3>Python, PHP & Databases</h3>
        <p>Backends and APIs in Python and PHP with MySQL, PostgreSQL and MongoDB.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="about-cta">
  <div class="wrap" style="text-align:center">
    <span class="eyebrow" style="color:var(--gold)">Let's Connect</span>
    <h2 class="serif-title reveal" style="font-size:clamp(30px,4vw,48px);color:var(--cream-3);margin-top:14px">Ready to work together?</h2>
    <p class="reveal" style="color:rgba(251,248,240,.65);max-width:480px;margin:20px auto 36px;font-size:16px">Tell me about your project and I will send a proposal with scope, timeline and cost.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap">
      <a href="/contact" class="btn btn-cream reveal">Start a Conversation</a>
      <a href="/portfolio" class="btn btn-outline-light reveal">See My Portfolio →</a>
    </div>
  </div>
</section>

<Footer />
</Layout>

<style>
.intro-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 60px; align-items: start; }
.intro-label { padding-top: 6px; }
.intro-body .serif-title { font-size: clamp(28px, 3.5vw, 42px); }
.intro-body p { color: var(--muted); font-size: 16px; line-height: 1.8; margin-top: 24px; }

/* EXPERIENCE */
.exp-section { background: var(--cream-2); }
.section-head { margin-bottom: 56px; }
.section-head .serif-title { font-size: clamp(28px, 3.5vw, 42px); margin-top: 10px; }
.timeline { display: flex; flex-direction: column; gap: 0; }
.timeline-item { display: grid; grid-template-columns: 200px 1fr; gap: 40px; padding: 40px 0; border-bottom: 1px solid var(--line-2); }
.timeline-item:last-child { border-bottom: 0; }
.tl-meta { padding-top: 4px; }
.tl-year { display: block; font-family: var(--display); font-weight: 800; font-size: 15px; color: var(--ink); }
.tl-tag { display: inline-block; margin-top: 8px; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: var(--olive); background: rgba(86,92,43,.1); padding: 3px 10px; border-radius: 20px; }
.tl-body h3 { font-family: var(--serif); font-weight: 700; font-size: 22px; color: var(--ink); margin-bottom: 4px; }
.tl-company { font-size: 13px; color: var(--gold); font-weight: 600; letter-spacing: .06em; margin-bottom: 14px; }
.tl-body p { font-size: 15px; color: var(--muted); line-height: 1.75; }
.tl-stack { margin-top: 16px; font-size: 12px; font-family: 'Courier New', monospace; color: var(--olive-2); letter-spacing: .04em; }

/* PHILOSOPHY */
.philosophy { background: var(--cream); }
.phil-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
.phil-text .serif-title { font-size: clamp(28px, 3.5vw, 42px); margin-top: 14px; }
.phil-text p { color: var(--muted); font-size: 16px; line-height: 1.8; margin-top: 20px; }
.phil-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
.pstat { background: var(--cream-2); border: 1px solid var(--line-2); border-radius: var(--r-md); padding: 28px 24px; text-align: center; }
.pnum { font-family: var(--display); font-weight: 800; font-size: 42px; color: var(--olive); line-height: 1; }
.plab { font-size: 13px; color: var(--muted); margin-top: 8px; font-weight: 500; }

/* CAPABILITIES */
.skills-overview { background: var(--cream-2); }
.caps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 52px; }
.cap-card { background: var(--white); border-radius: var(--r-md); padding: 30px 28px; border: 1px solid var(--line-2); box-shadow: var(--shadow-sm); transition: .25s; }
.cap-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }
.cap-icon { width: 52px; height: 52px; border-radius: 14px; background: rgba(86,92,43,.1); display: grid; place-items: center; margin-bottom: 18px; }
.cap-card h3 { font-family: var(--serif); font-weight: 700; font-size: 19px; margin-bottom: 10px; }
.cap-card p { font-size: 14px; color: var(--muted); line-height: 1.7; }

/* ABOUT CTA */
.about-cta { background: var(--olive-dark); padding: 96px 0; }
.btn-outline-light { background: transparent; color: var(--cream-3); border: 1.5px solid rgba(251,248,240,.3); border-radius: 10px; font-size: 16px; }
.btn-outline-light:hover { background: rgba(255,255,255,.1); }

@media (max-width: 980px) {
  .intro-grid { grid-template-columns: 1fr; gap: 24px; }
  .timeline-item { grid-template-columns: 1fr; gap: 12px; }
  .phil-grid { grid-template-columns: 1fr; gap: 48px; }
  .caps-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .caps-grid { grid-template-columns: 1fr; }
  .phil-stats { grid-template-columns: 1fr 1fr; }
}
</style>
