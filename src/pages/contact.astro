---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, FORM, FAQS } from '../data/site';
import { getServices } from '../lib/content';

const services = await getServices();
---


<Layout title="Contact Karandeep Arora | Hire a Freelance Full Stack Developer" description="Tell Karandeep Arora about your WordPress, React JS, Twilio, Python, PHP or Magento project and get a proposal with scope, timeline and cost.">
<Header activePage="/contact" />

<!-- HERO -->
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow reveal">Get In Touch</span>
    <h1 class="reveal">Let's Build<br>Something Together</h1>
    <p class="reveal">Whether you have a project in mind, a question about my work, or just want to connect — I'd love to hear from you.</p>
  </div>
</section>

<!-- CONTACT GRID -->
<section class="section contact-section">
  <div class="wrap contact-grid">

    <!-- LEFT: Info -->
    <div class="contact-info reveal">
      <h2 class="serif-title" style="font-size:clamp(26px,3vw,38px)">What can I help you with?</h2>
      <p class="contact-intro">I take on freelance and contract projects in WordPress, React JS, Twilio, Python, PHP, Magento and backend development. Share what you need and I will send a proposal with scope, timeline and cost.</p>

      <div class="info-items">
        <div class="info-item">
          <div class="info-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
          </div>
          <div>
            <div class="info-key">Email</div>
            <div class="info-val"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
          </div>
        </div>
        <div class="info-item">
          <div class="info-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
          </div>
          <div>
            <div class="info-key">Phone / WhatsApp</div>
            <div class="info-val"><a href={SITE.phoneHref}>{SITE.phone}</a></div>
          </div>
        </div>
        <div class="info-item">
          <div class="info-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
          </div>
          <div>
            <div class="info-key">Location</div>
            <div class="info-val">India (working with clients across time zones)</div>
          </div>
        </div>
      </div>

      <div class="availability">
        <div class="avail-dot"></div>
        <span>Available for new projects</span>
      </div>

      <div class="social-links">
        <span class="social-label">Find me on</span>
        <div class="socials">
          <a href={SITE.linkedin} class="social-btn" aria-label="LinkedIn" rel="noopener" target="_blank">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href={SITE.upwork} class="social-btn" aria-label="Upwork" rel="noopener" target="_blank"><span class="txt-ico">Up</span></a>
          <a href={SITE.whatsapp} class="social-btn" aria-label="WhatsApp" rel="noopener" target="_blank"><span class="txt-ico">WA</span></a>
          <a href={SITE.instagram} class="social-btn" aria-label="Instagram" rel="noopener" target="_blank"><span class="txt-ico">IG</span></a>
        </div>
      </div>
    </div>

    <!-- RIGHT: Form -->
    <div class="form-card reveal">
      <h3 class="form-title">Send a Message</h3>
      <form class="contact-form" id="contactForm">
        <div class="form-row">
          <div class="field">
            <label for="firstName">First Name</label>
            <input id="firstName" name="firstName" type="text" placeholder="Alex" required />
          </div>
          <div class="field">
            <label for="lastName">Last Name</label>
            <input id="lastName" name="lastName" type="text" placeholder="Johnson" required />
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="email">Email Address</label>
            <input id="email" name="email" type="email" placeholder="alex@company.com" required />
          </div>
          <div class="field">
            <label for="phone">Phone (optional)</label>
            <input id="phone" name="phone" type="tel" placeholder="+1 555 000 0000" />
          </div>
        </div>
        <div class="field">
          <label for="serviceInterest">Service</label>
          <select id="serviceInterest" name="serviceInterest">
            <option value="">— Select a service —</option>
            {services.map((sv) => <option value={sv.title}>{sv.title}</option>)}
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" placeholder="Tell me about your project, timeline, and budget…" required></textarea>
        </div>
        <div class="cf-turnstile" data-sitekey={FORM.turnstileSiteKey} data-callback="onTurnstileSuccess"></div>
        <p class="form-error" id="formError" role="alert"></p>
        <button type="submit" class="btn btn-dark submit-btn" id="submitBtn">
          Send Message
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
        </button>
      </form>
    </div>
  </div>
</section>

<!-- FAQ PREVIEW -->
<section class="section faq-preview">
  <div class="wrap" style="text-align:center">
    <span class="eyebrow reveal">Before You Write</span>
    <h2 class="serif-title reveal" style="font-size:clamp(26px,3vw,38px);margin-top:12px">Common Questions</h2>
    <div class="faq-preview-list">
      {FAQS.slice(0, 3).map((f) => (
      <div class="fq reveal">
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </div>
      ))}
    </div>
    <a href="/faq" class="btn btn-outline reveal" style="margin-top:36px">View All FAQs →</a>
  </div>
</section>

<Footer />
</Layout>

<style>
.contact-section { background: var(--cream); }
.contact-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 60px; align-items: start; }
.contact-intro { color: var(--muted); font-size: 16px; line-height: 1.75; margin: 20px 0 36px; max-width: 380px; }
.info-items { display: flex; flex-direction: column; gap: 20px; margin-bottom: 32px; }
.info-item { display: flex; align-items: center; gap: 16px; }
.info-icon { width: 46px; height: 46px; border-radius: 12px; background: var(--white); border: 1px solid var(--line-2); display: grid; place-items: center; color: var(--olive); flex: none; box-shadow: var(--shadow-sm); }
.info-key { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
.info-val { font-weight: 600; font-size: 15px; color: var(--ink); margin-top: 2px; }
.availability { display: flex; align-items: center; gap: 10px; font-size: 13.5px; font-weight: 600; color: var(--ink); margin-bottom: 32px; }
.avail-dot { width: 9px; height: 9px; border-radius: 50%; background: #4caf50; box-shadow: 0 0 0 3px rgba(76,175,80,.2); }
.social-label { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); font-weight: 600; display: block; margin-bottom: 12px; }
.socials { display: flex; gap: 10px; }
.social-btn { width: 42px; height: 42px; border-radius: 10px; background: var(--white); border: 1px solid var(--line-2); display: grid; place-items: center; color: var(--ink-2); transition: .2s; box-shadow: var(--shadow-sm); }
.social-btn:hover { background: var(--olive); color: var(--cream-3); border-color: var(--olive); }

.form-card { background: var(--white); border-radius: var(--r-lg); padding: 40px; border: 1px solid var(--line-2); box-shadow: var(--shadow-md); }
.form-title { font-family: var(--serif); font-weight: 700; font-size: 22px; color: var(--ink); margin-bottom: 28px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.field { margin-bottom: 20px; }
.field label { display: block; font-size: 12.5px; font-weight: 600; color: var(--ink-2); margin-bottom: 8px; letter-spacing: .04em; }
.field input, .field select, .field textarea { width: 100%; padding: 13px 15px; border: 1.5px solid var(--line); border-radius: 11px; font-family: var(--body); font-size: 14.5px; background: var(--cream-3); color: var(--ink); transition: .2s; outline: none; }
.field textarea { min-height: 120px; resize: vertical; }
.field input:focus, .field select:focus, .field textarea:focus { border-color: var(--olive); background: var(--white); }
.submit-btn { width: 100%; justify-content: center; margin-top: 6px; }

/* FAQ PREVIEW */
.faq-preview { background: var(--cream-2); }
.faq-preview-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 44px; text-align: left; }
.fq { background: var(--white); border: 1px solid var(--line-2); border-radius: var(--r-md); padding: 28px; box-shadow: var(--shadow-sm); }
.fq h3 { font-family: var(--serif); font-weight: 700; font-size: 18px; margin-bottom: 10px; }
.fq p { font-size: 14px; color: var(--muted); line-height: 1.7; }

@media (max-width: 980px) {
  .contact-grid { grid-template-columns: 1fr; }
  .faq-preview-list { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .form-row { grid-template-columns: 1fr; }
}
.info-val a { color: inherit; }
.info-val a:hover { color: var(--olive); }
.txt-ico { font-size: 11px; font-weight: 800; letter-spacing: .02em; }
.form-error { color: #B3261E; font-size: 13.5px; min-height: 1.2em; margin: 4px 0 8px; }
.cf-turnstile { margin: 4px 0 8px; }
</style>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script define:vars={{ endpoint: FORM.endpoint, sourceSite: FORM.sourceSite, services: services.map((x) => x.title) }}>
  let turnstileToken = '';
  window.onTurnstileSuccess = (token) => { turnstileToken = token; };

  const form = document.getElementById('contactForm');
  const errorEl = document.getElementById('formError');
  const submitBtn = document.getElementById('submitBtn');

  // /contact?plan=Magento-Development (legacy links from the service pages)
  const plan = new URLSearchParams(location.search).get('plan');
  if (plan) {
    const wanted = plan.replace(/-/g, ' ').toLowerCase();
    const match = services.find((t) => t.toLowerCase() === wanted);
    if (match) form.elements.serviceInterest.value = match;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.textContent = '';
    if (!turnstileToken) {
      errorEl.textContent = 'Please complete the verification challenge.';
      return;
    }
    const fd = new FormData(form);
    const firstName = String(fd.get('firstName') || '').trim();
    const lastName = String(fd.get('lastName') || '').trim();
    const serviceInterest = String(fd.get('serviceInterest') || '');
    const payload = {
      turnstileToken,
      data: {
        name: [firstName, lastName].filter(Boolean).join(' '),
        firstName,
        lastName,
        email: fd.get('email'),
        phone: fd.get('phone'),
        serviceInterest,
        message: fd.get('message'),
        formType: plan ? 'service-contact' : 'contact',
        sourceSite,
      },
    };
    submitBtn.disabled = true;
    try {
      const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (!res.ok) {
        const body = await res.json().catch(() => null);
        throw new Error(body?.error?.message || 'Something went wrong. Please try again.');
      }
      window.location.href = '/thank-you';
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : 'Something went wrong. Please try again.';
      submitBtn.disabled = false;
      if (window.turnstile) { window.turnstile.reset(); turnstileToken = ''; }
    }
  });
</script>
