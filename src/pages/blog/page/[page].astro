---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getBlogPosts, categoryOf, formatDate } from '../../../lib/content';

const PAGE_SIZE = 12;

export async function getStaticPaths() {
  const all = await getBlogPosts();
  const totalPages = Math.ceil(all.length / PAGE_SIZE);
  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const page = i + 2;
    const start = (page - 1) * PAGE_SIZE;
    return {
      params: { page: String(page) },
      props: { posts: all.slice(start, start + PAGE_SIZE), page, totalPages },
    };
  });
}

const { posts, page, totalPages } = Astro.props;
---

<Layout
  title={`Blog – Page ${page} | Karandeep Arora`}
  description={`Articles on WordPress, React JS, Python, PHP, Magento and Twilio development — page ${page}.`}
>
<Header activePage="/blog" />

<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow reveal">Blog</span>
    <h1 class="reveal">Articles &<br>Insights</h1>
    <p class="reveal">Practical writing on WordPress, React JS, Python, PHP, Magento and Twilio development.</p>
  </div>
</section>

<section class="section blog-section">
  <div class="wrap">
    <div class="blog-head reveal">
      <h2 class="serif-title">All Articles</h2>
    </div>
    <div class="blog-posts-grid">
      {posts.map(post => (
        <article class="blog-card reveal">
          <a href={`/blog/${post.slug}`} class="blog-card-link">
            <div class="blog-img">
              <img src={post.image} alt={post.title} loading="lazy" />
            </div>
            <div class="blog-body">
              <div class="blog-meta">
                <span class="blog-cat">{categoryOf(post)}</span>
                <span class="blog-date">{formatDate(post.publishDate)} · {post.readTime}</span>
              </div>
              <h3 class="blog-title">{post.title}</h3>
              <span class="blog-read">Read More →</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<nav class="pagination">
  <span class="pg-info">Page {page} of {totalPages}</span>
  <div class="pg-controls">
    {page > 1 && (
      <a href={page === 2 ? '/blog' : `/blog/page/${page - 1}`} class="pg-btn">← Prev</a>
    )}
    {page > 2 && <a href="/blog" class="pg-btn">1</a>}
    {page > 3 && <span class="pg-btn disabled">…</span>}
    {page > 1 && <a href={page === 2 ? '/blog' : `/blog/page/${page - 1}`} class="pg-btn">{page - 1}</a>}
    <span class="pg-btn active">{page}</span>
    {page < totalPages && <a href={`/blog/page/${page + 1}`} class="pg-btn">{page + 1}</a>}
    {page < totalPages - 2 && <span class="pg-btn disabled">…</span>}
    {page < totalPages - 1 && <a href={`/blog/page/${totalPages}`} class="pg-btn">{totalPages}</a>}
    {page < totalPages && (
      <a href={`/blog/page/${page + 1}`} class="pg-btn pg-next">Next →</a>
    )}
  </div>
</nav>

<Footer />
</Layout>

<style>
.blog-section { background: var(--cream-2); }
.blog-head { margin-bottom: 44px; }
.blog-head .serif-title { font-size: clamp(28px, 3.5vw, 40px); }
.blog-posts-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
.blog-card { background: var(--white); border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line-2); box-shadow: var(--shadow-sm); transition: .3s; }
.blog-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }
.blog-card-link { text-decoration: none; display: block; }
.blog-img { aspect-ratio: 16/10; overflow: hidden; }
.blog-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
.blog-card:hover .blog-img img { transform: scale(1.05); }
.blog-body { padding: 22px 24px 26px; }
.blog-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.blog-cat { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; font-weight: 700; color: var(--gold); }
.blog-date { font-size: 12px; color: var(--muted); }
.blog-title { font-family: var(--serif); font-weight: 700; font-size: 18px; color: var(--ink); line-height: 1.35; margin-bottom: 14px; }
.blog-read { font-size: 13px; font-weight: 600; color: var(--olive); }

.pagination { background: var(--cream-2); padding: 40px 0 60px; display: flex; flex-direction: column; align-items: center; gap: 14px; }
.pg-info { font-size: 13px; color: var(--muted); font-weight: 500; }
.pg-controls { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; }
.pg-btn { display: inline-flex; align-items: center; justify-content: center; min-width: 42px; height: 42px; padding: 0 14px; border-radius: 10px; font-size: 14px; font-weight: 600; border: 1.5px solid var(--line-2); background: var(--white); color: var(--ink); transition: .2s; text-decoration: none; }
.pg-btn:hover:not(.disabled):not(.active) { border-color: var(--olive); color: var(--olive); }
.pg-btn.active { background: var(--olive); color: #fff; border-color: var(--olive); }
.pg-btn.disabled { color: var(--muted); cursor: default; opacity: .5; }
.pg-btn.pg-next { color: var(--olive); border-color: var(--olive); }

@media (max-width: 980px) { .blog-posts-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) { .blog-posts-grid { grid-template-columns: 1fr; } }
</style>
