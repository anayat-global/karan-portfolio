---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../data/site';
import { getBlogPosts, categoryOf, formatDate } from '../../lib/content';

// Slugs are the legacy URLs verbatim (/blog/<slug>), including the mixed-case
// "...-It-requires..." one, so existing links and rankings keep working.
export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, more: posts.filter((p) => p.slug !== post.slug).slice(0, 3) },
  }));
}

const { post, more } = Astro.props;

// Keyword → service-specific FAQs. Fallback = general "working with me" questions.
const FAQ_MAP: Record<string, { q: string; a: string }[]> = {
  wordpress: [
    { q: 'Can you build a custom WordPress theme or plugin?', a: 'Yes. I build fully custom WordPress themes and plugins from scratch, tailored to your brand and requirements — no page-builder bloat, clean and maintainable code.' },
    { q: 'Can you migrate my existing website to WordPress?', a: 'Yes. I offer WordPress migration services that move your site and data safely, optimise content and keep downtime to a minimum.' },
    { q: 'Do you offer WooCommerce development?', a: 'Yes. I build and customise WooCommerce stores including custom product types, payment gateways, shipping rules and third-party integrations.' },
  ],
  react: [
    { q: 'Can you build a React JS web application from scratch?', a: 'Yes. I build interactive, scalable single-page and full-stack applications with React JS, connecting them to REST APIs, GraphQL endpoints and third-party services.' },
    { q: 'Can you build mobile apps with React Native?', a: 'Yes. I build cross-platform mobile apps with React Native that share a codebase between iOS and Android, connected to your existing backend or a new one.' },
    { q: 'What backends do you pair with React?', a: 'I typically pair React with Node.js, Python (Django/FastAPI) or PHP backends, and can integrate any REST or GraphQL API your project requires.' },
  ],
  mern: [
    { q: 'What is a MERN stack application?', a: 'MERN stands for MongoDB, Express, React and Node.js — a full JavaScript stack for building modern, scalable web applications end to end.' },
    { q: 'Can you build a full MERN stack app from scratch?', a: 'Yes. I handle the full MERN stack: database design in MongoDB, REST or GraphQL APIs with Express and Node, and a React front end, through to deployment.' },
    { q: 'Do you work with international clients on MERN projects?', a: 'Yes. I have worked with clients in Australia, the US, the UK, Canada, Japan and India and am comfortable working across time zones.' },
  ],
  python: [
    { q: 'What kind of Python projects do you take on?', a: 'Web applications, REST APIs, Django and FastAPI backends, data processing scripts, automation tools and integrations with third-party services.' },
    { q: 'Can you build a Django web application?', a: 'Yes. Django is my primary Python framework for web apps. I also work with FastAPI for high-performance API projects.' },
    { q: 'How much does Python development cost?', a: 'It depends on scope and complexity. Share your requirements through the contact form and I will send a proposal with a clear timeline and cost.' },
  ],
  php: [
    { q: 'What PHP frameworks do you work with?', a: 'I work with Laravel, CodeIgniter and core PHP. I also build and maintain custom PHP applications and legacy codebases.' },
    { q: 'Can you build a custom PHP web application?', a: 'Yes. I build secure, scalable PHP applications, REST APIs and enterprise-grade platforms tailored to your business requirements.' },
    { q: 'Do you provide support after the PHP project launches?', a: 'Yes. I offer ongoing maintenance and support including updates, security patches and performance tuning after every project.' },
  ],
  magento: [
    { q: 'Do you work on Magento 2?', a: 'Yes. I work exclusively on Magento 2 for new projects — custom themes, modules, performance optimisation and third-party integrations.' },
    { q: 'Can you migrate my store to Magento?', a: 'Yes. I offer Magento migration services that move your catalogue, customers and orders safely with minimal downtime.' },
    { q: 'What is the difference between hiring a freelance Magento developer and an agency?', a: 'A freelance developer typically costs less, communicates directly with you and can move faster on focused projects. An agency adds layers of management and cost that may not suit smaller or mid-sized stores.' },
  ],
  twilio: [
    { q: 'What Twilio services do you integrate?', a: 'SMS, voice, video, Twilio Flex (contact centre), Twilio Studio (flow automation) and Verify (two-factor authentication).' },
    { q: 'Can you add SMS or WhatsApp notifications to my application?', a: 'Yes. I integrate Twilio SMS and WhatsApp APIs into existing web and mobile applications, including triggered notifications, OTPs and two-way messaging flows.' },
    { q: 'How long does a Twilio integration take?', a: 'A basic SMS or voice integration typically takes a few days. More complex flows like Flex or Studio automations depend on scope — share your requirements and I will estimate.' },
  ],
  fullstack: [
    { q: 'What does a full stack developer do?', a: 'A full stack developer works on both the front end (user interface) and back end (server, database, APIs) of a web application, delivering the whole product rather than just one layer.' },
    { q: 'What are the key advantages of hiring a freelance full stack developer?', a: 'You get a single point of contact who understands the whole system, faster communication, lower cost than an agency and the flexibility to scale up or down as your project evolves.' },
    { q: 'Do you work with international clients?', a: 'Yes. I have worked with startups, sole founders and businesses in Australia, the US, the UK, Canada, Japan and India and am comfortable working across time zones.' },
  ],
};

const FALLBACK_FAQS = [
  { q: 'How does a project work?', a: 'We start with a discussion of your goals, then I send a proposal covering scope, timeline and cost. After a contract and kickoff call, I build in stages with regular updates, then test, launch and support the project.' },
  { q: 'Do you work with international clients?', a: 'Yes. I have worked with startups, sole founders and businesses in Australia, the US, the UK, Canada, Japan and India and am comfortable working across time zones.' },
  { q: 'Do you provide support after launch?', a: 'Yes. I offer ongoing maintenance and support including updates, backups, security and performance tuning so your site keeps running smoothly after it goes live.' },
];

function getPostFaqs(slug: string) {
  const s = slug.toLowerCase();
  if (s.includes('wordpress') || s.includes('woocommerce')) return FAQ_MAP.wordpress;
  if (s.includes('mern')) return FAQ_MAP.mern;
  if (s.includes('react')) return FAQ_MAP.react;
  if (s.includes('python')) return FAQ_MAP.python;
  if (s.includes('php')) return FAQ_MAP.php;
  if (s.includes('magento')) return FAQ_MAP.magento;
  if (s.includes('twilio')) return FAQ_MAP.twilio;
  if (s.includes('full-stack') || s.includes('fullstack') || s.includes('full_stack')) return FAQ_MAP.fullstack;
  return FALLBACK_FAQS;
}

const postFaqs = getPostFaqs(post.slug);

// Give every h2-h4 an id and collect them for the table of contents.
const toc: { id: string; text: string }[] = [];
let n = 0;
const body = post.content.replace(/<(h[234])>([\s\S]*?)<\/\1>/g, (_m, tag, inner) => {
  const text = inner.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
  const id = `section-${++n}`;
  if (tag !== 'h4' || toc.length < 12) toc.push({ id, text });
  return `<${tag} id="${id}">${inner}</${tag}>`;
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.description,
    datePublished: post.publishDate.toISOString().slice(0, 10),
    image: new URL(post.image, SITE.url).href,
    author: { '@type': 'Person', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Person', name: SITE.name, url: SITE.url },
    mainEntityOfPage: `${SITE.url}/blog/${post.slug}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: postFaqs.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
      { '@type': 'ListItem', position: 3, name: post.title, item: `${SITE.url}/blog/${post.slug}` },
    ],
  },
];
---

<Layout title={`${post.title} | Karandeep Arora`} description={post.description} image={post.image} type="article" publishedTime={post.publishDate.toISOString()}>
<Header activePage="/blog" />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<div class="breadcrumb-bar">
  <div class="wrap">
    <a href="/blog">← Back to Articles</a>
  </div>
</div>

<section class="article-hero">
  <div class="wrap">
    <div class="article-meta reveal">
      <span class="art-cat">{categoryOf(post)}</span>
      <span class="art-date">{formatDate(post.publishDate)}</span>
      <span class="art-read">{post.readTime}</span>
    </div>
    <h1 class="art-title reveal">{post.title}</h1>
    <div class="art-author reveal">
      <img src="/karan-profile.webp" alt={SITE.name} />
      <div>
        <div class="auth-name">{SITE.name}</div>
        <div class="auth-role">{SITE.role}</div>
      </div>
    </div>
  </div>
</section>

<div class="art-cover">
  <div class="wrap">
    <div class="cover-img reveal">
      <img src={post.image} alt={post.title} />
    </div>
  </div>
</div>

<section class="article-body">
  <div class="wrap">
    <div class={`art-layout${toc.length > 1 ? '' : ' no-toc'}`}>
      {toc.length > 1 && (
      <aside class="art-sidebar">
        <div class="toc-card">
          <div class="toc-label">Contents</div>
          <nav class="toc">
            {toc.map((t, i) => <a href={`#${t.id}`} class={`toc-link${i === 0 ? ' active' : ''}`}>{t.text}</a>)}
          </nav>
        </div>
      </aside>
      )}
      <article class="art-content" set:html={body} />
    </div>
  </div>
</section>

<section class="section post-faq">
  <div class="wrap">
    <h2 class="serif-title reveal">Frequently Asked Questions</h2>
    <div class="faq-list">
      {postFaqs.map((f, i) => (
        <div class={`faq-item reveal${i === 0 ? ' open' : ''}`}>
          <button class="faq-q">{f.q} <span class="plus">+</span></button>
          <div class="faq-a"><p>{f.a}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <h2>Need a Developer for <em>Your Project?</em></h2>
    <p>Tell me what you are building and I will send a proposal with scope, timeline and cost.</p>
    <a href="/contact" class="btn btn-dark">Start a Project</a>
  </div>
</section>

<section class="section more-articles">
  <div class="wrap">
    <h2 class="serif-title reveal">More Articles</h2>
    <div class="more-grid">
      {more.map((m) => (
      <a href={`/blog/${m.slug}`} class="more-card reveal">
        <div class="more-img"><img src={m.image} alt="" loading="lazy" /></div>
        <div class="more-body"><span class="more-cat">{categoryOf(m)}</span><h3>{m.title}</h3></div>
      </a>
      ))}
    </div>
  </div>
</section>

<Footer />
</Layout>

<style>
.breadcrumb-bar { background: var(--cream-2); padding: 14px 0; border-bottom: 1px solid var(--line-2); }
.breadcrumb-bar a { font-size: 14px; color: var(--olive); font-weight: 600; }
.breadcrumb-bar a:hover { color: var(--ink); }

.article-hero { background: var(--cream); padding: 56px 0 40px; }
.article-meta { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
.art-cat { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; color: var(--ink); background: var(--gold-2); padding: 4px 14px; border-radius: 20px; }
.art-date, .art-read { font-size: 13px; color: var(--muted); }
.art-title { font-family: var(--serif); font-size: clamp(28px, 4.5vw, 52px); font-weight: 700; color: var(--ink); line-height: 1.15; max-width: 840px; }
.art-author { display: flex; align-items: center; gap: 13px; margin-top: 28px; }
.art-author img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; object-position: top; background: var(--cream-2); }
.auth-name { font-weight: 600; font-size: 14.5px; color: var(--ink); }
.auth-role { font-size: 12px; color: var(--muted); }

.art-cover { background: var(--cream); padding: 0 0 60px; }
.cover-img { border-radius: var(--r-lg); overflow: hidden; aspect-ratio: 21/9; box-shadow: var(--shadow-lg); }
.cover-img img { width: 100%; height: 100%; object-fit: cover; }

.article-body { background: var(--cream-2); padding: 60px 0 80px; }
.art-layout { display: grid; grid-template-columns: 220px 1fr; gap: 60px; align-items: start; }
.art-layout.no-toc { grid-template-columns: 1fr; justify-items: center; }
.art-sidebar { position: sticky; top: 94px; }
.toc-card { background: var(--white); border: 1px solid var(--line-2); border-radius: var(--r-md); padding: 24px; box-shadow: var(--shadow-sm); }
.toc-label { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; font-weight: 700; color: var(--muted); margin-bottom: 16px; }
.toc { display: flex; flex-direction: column; gap: 4px; }
.toc-link { font-size: 13.5px; color: var(--muted); font-weight: 500; padding: 6px 10px; border-radius: 6px; transition: .2s; border-left: 2px solid transparent; }
.toc-link:hover { color: var(--ink); background: var(--cream-2); }
.toc-link.active { color: var(--olive); border-left-color: var(--olive); background: rgba(86,92,43,.06); }

.art-content { max-width: 100%; }
.art-content :global(h2) { font-family: var(--serif); font-weight: 700; font-size: 28px; color: var(--ink); margin: 48px 0 18px; padding-top: 12px; border-top: 1px solid var(--line-2); }
.art-content :global(h2:first-child) { margin-top: 0; border-top: 0; }
.art-content :global(h3), .art-content :global(h4) { font-family: var(--serif); font-weight: 700; font-size: 20px; color: var(--ink); margin: 30px 0 12px; }
.art-content :global(p) { font-size: 16px; color: var(--ink-2); line-height: 1.85; margin-bottom: 18px; }
.art-content :global(ul), .art-content :global(ol) { margin: 12px 0 20px 22px; }
.art-content :global(li) { font-size: 16px; color: var(--ink-2); line-height: 1.8; margin-bottom: 8px; list-style: disc; }
.art-content :global(ol li) { list-style: decimal; }
.art-content :global(li p) { margin-bottom: 6px; }
.art-content :global(a) { color: var(--olive); text-decoration: underline; }
.art-content :global(img) { border-radius: var(--r-md); margin: 20px 0; }
.art-content :global(h4) { font-size: 18px; }
.art-content :global(blockquote) { border-left: 3px solid var(--gold); padding: 16px 24px; background: var(--cream); margin: 28px 0; font-family: var(--serif); font-size: 18px; font-style: italic; color: var(--ink-2); border-radius: 0 var(--r-sm) var(--r-sm) 0; }
.art-content :global(pre) { background: var(--ink); color: var(--cream-3); border-radius: var(--r-md); padding: 22px 24px; margin: 24px 0; overflow-x: auto; }
.art-content :global(code) { font-family: 'Courier New', monospace; font-size: 13.5px; line-height: 1.7; }
.art-content :global(p code) { background: var(--line-2); color: var(--olive-dark); padding: 2px 7px; border-radius: 4px; font-size: 13.5px; }

/* POST FAQ */
.post-faq { background: var(--cream); text-align: center; }
.post-faq .serif-title { font-size: clamp(26px, 3vw, 38px); margin-bottom: 36px; }
.faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px; }
.faq-item { background: var(--white); border: 1px solid var(--line-2); border-radius: 14px; overflow: hidden; box-shadow: var(--shadow-sm); }
.faq-q { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 24px; background: none; border: 0; cursor: pointer; text-align: left; font-family: var(--body); font-weight: 600; font-size: 15.5px; color: var(--ink); }
.faq-q .plus { font-size: 22px; color: var(--gold); transition: .3s; flex: none; line-height: 1; }
.faq-item.open .faq-q .plus { transform: rotate(45deg); }
.faq-a { max-height: 0; overflow: hidden; transition: max-height .35s ease; color: var(--muted); font-size: 14.5px; }
.faq-a p { padding: 0 24px 22px; text-align: left; }
.faq-item.open .faq-a { max-height: 300px; }

.cta { background: var(--cream-2); }

.more-articles { background: var(--cream); }
.more-articles .serif-title { font-size: clamp(26px, 3vw, 36px); margin-bottom: 36px; }
.more-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
.more-card { background: var(--white); border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line-2); box-shadow: var(--shadow-sm); transition: .3s; text-decoration: none; display: block; }
.more-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }
.more-img { aspect-ratio: 16/10; overflow: hidden; }
.more-img img { width: 100%; height: 100%; object-fit: cover; transition: .5s; }
.more-card:hover .more-img img { transform: scale(1.05); }
.more-body { padding: 20px 22px; }
.more-cat { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; font-weight: 700; color: var(--gold); display: block; margin-bottom: 8px; }
.more-body h3 { font-family: var(--serif); font-weight: 700; font-size: 17px; color: var(--ink); line-height: 1.35; }

@media (max-width: 980px) {
  .art-layout { grid-template-columns: 1fr; }
  .art-sidebar { position: static; }
  .more-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .more-grid { grid-template-columns: 1fr; }
}
</style>

<script>
  document.querySelectorAll('.post-faq .faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const isOpen = item?.classList.contains('open');
      document.querySelectorAll('.post-faq .faq-item').forEach(i => i.classList.remove('open'));
      if (!isOpen) item?.classList.add('open');
    });
  });
</script>
