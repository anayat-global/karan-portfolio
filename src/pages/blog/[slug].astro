---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../data/site';
import { getBlogPosts, categoryOf, formatDate } from '../../lib/content';

// Slugs are the legacy URLs verbatim (/blog/<slug>), including the mixed-case
// "...-It-requires..." one, so existing links and rankings keep working.
export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, more: posts.filter((p) => p.slug !== post.slug).slice(0, 3) },
  }));
}

const { post, more } = Astro.props;

// Give every h2-h4 an id and collect them for the table of contents.
const toc: { id: string; text: string }[] = [];
let n = 0;
const body = post.content.replace(/<(h[234])>([\s\S]*?)<\/\1>/g, (_m, tag, inner) => {
  const text = inner.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
  const id = `section-${++n}`;
  if (tag !== 'h4' || toc.length < 12) toc.push({ id, text });
  return `<${tag} id="${id}">${inner}</${tag}>`;
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.publishDate.toISOString().slice(0, 10),
  image: new URL(post.image, SITE.url).href,
  author: { '@type': 'Person', name: SITE.name },
  mainEntityOfPage: `${SITE.url}/blog/${post.slug}`,
};
---

<Layout title={`${post.title} | Karandeep Arora`} description={post.description} image={post.image} type="article">
<Header activePage="/blog" />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<div class="breadcrumb-bar">
  <div class="wrap">
    <a href="/blog">← Back to Articles</a>
  </div>
</div>

<section class="article-hero">
  <div class="wrap">
    <div class="article-meta reveal">
      <span class="art-cat">{categoryOf(post)}</span>
      <span class="art-date">{formatDate(post.publishDate)}</span>
      <span class="art-read">{post.readTime}</span>
    </div>
    <h1 class="art-title reveal">{post.title}</h1>
    <div class="art-author reveal">
      <img src="/demo-removebg-preview.png" alt={SITE.name} />
      <div>
        <div class="auth-name">{SITE.name}</div>
        <div class="auth-role">{SITE.role}</div>
      </div>
    </div>
  </div>
</section>

<div class="art-cover">
  <div class="wrap">
    <div class="cover-img reveal">
      <img src={post.image} alt={post.title} />
    </div>
  </div>
</div>

<section class="article-body">
  <div class="wrap">
    <div class={`art-layout${toc.length > 1 ? '' : ' no-toc'}`}>
      {toc.length > 1 && (
      <aside class="art-sidebar">
        <div class="toc-card">
          <div class="toc-label">Contents</div>
          <nav class="toc">
            {toc.map((t, i) => <a href={`#${t.id}`} class={`toc-link${i === 0 ? ' active' : ''}`}>{t.text}</a>)}
          </nav>
        </div>
      </aside>
      )}
      <article class="art-content" set:html={body} />
    </div>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <h2>Need a Developer for <em>Your Project?</em></h2>
    <p>Tell me what you are building and I will send a proposal with scope, timeline and cost.</p>
    <a href="/contact" class="btn btn-cream">Start a Project</a>
  </div>
</section>

<section class="section more-articles">
  <div class="wrap">
    <h2 class="serif-title reveal">More Articles</h2>
    <div class="more-grid">
      {more.map((m) => (
      <a href={`/blog/${m.slug}`} class="more-card reveal">
        <div class="more-img"><img src={m.image} alt="" loading="lazy" /></div>
        <div class="more-body"><span class="more-cat">{categoryOf(m)}</span><h3>{m.title}</h3></div>
      </a>
      ))}
    </div>
  </div>
</section>

<Footer />
</Layout>

<style>
.breadcrumb-bar { background: var(--cream-2); padding: 14px 0; border-bottom: 1px solid var(--line-2); }
.breadcrumb-bar a { font-size: 14px; color: var(--olive); font-weight: 600; }
.breadcrumb-bar a:hover { color: var(--ink); }

.article-hero { background: var(--cream); padding: 56px 0 40px; }
.article-meta { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
.art-cat { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; color: var(--ink); background: var(--gold-2); padding: 4px 14px; border-radius: 20px; }
.art-date, .art-read { font-size: 13px; color: var(--muted); }
.art-title { font-family: var(--serif); font-size: clamp(28px, 4.5vw, 52px); font-weight: 700; color: var(--ink); line-height: 1.15; max-width: 840px; }
.art-author { display: flex; align-items: center; gap: 13px; margin-top: 28px; }
.art-author img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; object-position: top; background: var(--cream-2); }
.auth-name { font-weight: 600; font-size: 14.5px; color: var(--ink); }
.auth-role { font-size: 12px; color: var(--muted); }

.art-cover { background: var(--cream); padding: 0 0 60px; }
.cover-img { border-radius: var(--r-lg); overflow: hidden; aspect-ratio: 21/9; box-shadow: var(--shadow-lg); }
.cover-img img { width: 100%; height: 100%; object-fit: cover; }

.article-body { background: var(--cream-2); padding: 60px 0 80px; }
.art-layout { display: grid; grid-template-columns: 220px 1fr; gap: 60px; align-items: start; }
.art-layout.no-toc { grid-template-columns: 1fr; justify-items: center; }
.art-sidebar { position: sticky; top: 94px; }
.toc-card { background: var(--white); border: 1px solid var(--line-2); border-radius: var(--r-md); padding: 24px; box-shadow: var(--shadow-sm); }
.toc-label { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; font-weight: 700; color: var(--muted); margin-bottom: 16px; }
.toc { display: flex; flex-direction: column; gap: 4px; }
.toc-link { font-size: 13.5px; color: var(--muted); font-weight: 500; padding: 6px 10px; border-radius: 6px; transition: .2s; border-left: 2px solid transparent; }
.toc-link:hover { color: var(--ink); background: var(--cream-2); }
.toc-link.active { color: var(--olive); border-left-color: var(--olive); background: rgba(86,92,43,.06); }

.art-content { max-width: 700px; }
.art-content :global(h2) { font-family: var(--serif); font-weight: 700; font-size: 28px; color: var(--ink); margin: 48px 0 18px; padding-top: 12px; border-top: 1px solid var(--line-2); }
.art-content :global(h2:first-child) { margin-top: 0; border-top: 0; }
.art-content :global(h3), .art-content :global(h4) { font-family: var(--serif); font-weight: 700; font-size: 20px; color: var(--ink); margin: 30px 0 12px; }
.art-content :global(p) { font-size: 16px; color: var(--ink-2); line-height: 1.85; margin-bottom: 18px; }
.art-content :global(ul), .art-content :global(ol) { margin: 12px 0 20px 22px; }
.art-content :global(li) { font-size: 16px; color: var(--ink-2); line-height: 1.8; margin-bottom: 8px; list-style: disc; }
.art-content :global(ol li) { list-style: decimal; }
.art-content :global(li p) { margin-bottom: 6px; }
.art-content :global(a) { color: var(--olive); text-decoration: underline; }
.art-content :global(img) { border-radius: var(--r-md); margin: 20px 0; }
.art-content :global(h4) { font-size: 18px; }
.art-content :global(blockquote) { border-left: 3px solid var(--gold); padding: 16px 24px; background: var(--cream); margin: 28px 0; font-family: var(--serif); font-size: 18px; font-style: italic; color: var(--ink-2); border-radius: 0 var(--r-sm) var(--r-sm) 0; }
.art-content :global(pre) { background: var(--ink); color: var(--cream-3); border-radius: var(--r-md); padding: 22px 24px; margin: 24px 0; overflow-x: auto; }
.art-content :global(code) { font-family: 'Courier New', monospace; font-size: 13.5px; line-height: 1.7; }
.art-content :global(p code) { background: var(--line-2); color: var(--olive-dark); padding: 2px 7px; border-radius: 4px; font-size: 13.5px; }

.more-articles { background: var(--cream); }
.more-articles .serif-title { font-size: clamp(26px, 3vw, 36px); margin-bottom: 36px; }
.more-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
.more-card { background: var(--white); border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line-2); box-shadow: var(--shadow-sm); transition: .3s; text-decoration: none; display: block; }
.more-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }
.more-img { aspect-ratio: 16/10; overflow: hidden; }
.more-img img { width: 100%; height: 100%; object-fit: cover; transition: .5s; }
.more-card:hover .more-img img { transform: scale(1.05); }
.more-body { padding: 20px 22px; }
.more-cat { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; font-weight: 700; color: var(--gold); display: block; margin-bottom: 8px; }
.more-body h3 { font-family: var(--serif); font-weight: 700; font-size: 17px; color: var(--ink); line-height: 1.35; }

@media (max-width: 980px) {
  .art-layout { grid-template-columns: 1fr; }
  .art-sidebar { position: static; }
  .more-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .more-grid { grid-template-columns: 1fr; }
}
</style>
