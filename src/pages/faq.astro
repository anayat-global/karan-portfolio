---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const categories = [
  {
    id: "working-together",
    label: "Working Together",
    faqs: [
      { q: "Do you work with international clients?", a: "Yes. I have worked with startups, sole founders and businesses in Australia, the United States, the United Kingdom, Canada, Japan, Italy, India, Saudi Arabia and South Africa, and I am comfortable working across time zones and joining client meetings." },
      { q: "Can I hire you through Upwork?", a: "Yes. You can hire me directly through this website or on Upwork, where you can review my work history and ask for a proposal before starting." },
      { q: "How does a project work?", a: "We start with a discussion of your goals, then I send a proposal covering scope, timeline and cost. After a contract and kickoff call, I build in stages with regular updates through the channel you prefer, then test, launch and support the project." },
    ]
  },
  {
    id: "services-pricing",
    label: "Services & Pricing",
    faqs: [
      { q: "Which services do you offer?", a: "WordPress, Twilio, React JS, Python, PHP, Magento and backend development, from custom themes, plugins and API integrations to full web applications and e-commerce stores." },
      { q: "How much does a project cost?", a: "It depends on scope and complexity. Share your requirements through the contact form and I will send a proposal with a clear timeline and cost, so you know what to expect before we begin." },
      { q: "Can you build mobile apps?", a: "Yes. I build mobile and web apps with React JS and React Native, and can connect them to backends and third-party APIs, payment gateways and Twilio communication services." },
    ]
  },
  {
    id: "after-launch",
    label: "Migration & Support",
    faqs: [
      { q: "Can you migrate my existing website to WordPress?", a: "Yes. I offer WordPress migration services that move your site and data safely, optimise content and keep downtime to a minimum." },
      { q: "Do you provide support after launch?", a: "Yes. I offer ongoing maintenance and support, including updates, backups, security and performance tuning, so your site or application keeps running smoothly after it goes live." },
    ]
  },
];
---

<Layout title="FAQ | Karandeep Arora" description="Answers to common questions about hiring Karandeep Arora: services, process, pricing, support and working with international clients.">
<Header activePage="/faq" />

<!-- HERO -->
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow reveal">Questions & Answers</span>
    <h1 class="reveal">Frequently Asked<br>Questions</h1>
    <p class="reveal">Everything you need to know about working with me, from process and pricing to support after launch.</p>
  </div>
</section>

<!-- CATEGORY TABS -->
<section class="tab-bar">
  <div class="wrap">
    <div class="tabs" id="faqTabs">
      {categories.map((cat, i) => (
        <button class={i === 0 ? 'active' : ''} data-tab={cat.id}>{cat.label}</button>
      ))}
    </div>
  </div>
</section>

<!-- FAQ CONTENT -->
<section class="section faq-main">
  <div class="wrap faq-layout">
    <div class="faq-col">
      {categories.map((cat) => (
        <div class="faq-group" id={`tab-${cat.id}`} data-group={cat.id}>
          {cat.faqs.map((item, i) => (
            <div class={`faq-item reveal${i === 0 ? ' open' : ''}`}>
              <button class="faq-q">{item.q} <span class="plus">+</span></button>
              <div class="faq-a"><p>{item.a}</p></div>
            </div>
          ))}
        </div>
      ))}
    </div>

    <aside class="faq-cta-aside reveal">
      <div class="cta-aside-card">
        <div class="cta-aside-icon">
          <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
        </div>
        <h3>Still have questions?</h3>
        <p>Can't find what you're looking for? I'm happy to answer any question directly.</p>
        <a href="/contact" class="btn btn-dark" style="width:100%;justify-content:center;margin-top:20px">Start a Conversation</a>
      </div>
    </aside>
  </div>
</section>

<!-- INQUIRY CTA -->
<section class="inquiry-cta">
  <div class="wrap" style="text-align:center">
    <span class="eyebrow" style="color:var(--gold)">Ready to Start?</span>
    <h2 class="serif-title reveal" style="font-size:clamp(28px,3.5vw,44px);color:var(--cream-3);margin-top:14px">Let's work together.</h2>
    <p class="reveal" style="color:rgba(251,248,240,.65);max-width:480px;margin:18px auto 36px;font-size:16px">Great digital products are built through great collaboration. Let's see if we're a good fit.</p>
    <a href="/contact" class="btn btn-cream reveal">Get in Touch →</a>
  </div>
</section>

<Footer />
</Layout>

<style>
.tab-bar { background: var(--cream-2); padding: 20px 0; border-bottom: 1px solid var(--line-2); position: sticky; top: 74px; z-index: 40; backdrop-filter: blur(8px); }
.tabs { display: flex; gap: 8px; flex-wrap: wrap; }
.tabs button { border: 0; background: transparent; cursor: pointer; font-family: var(--body); font-size: 14px; font-weight: 600; color: var(--muted); padding: 10px 22px; border-radius: 30px; transition: .2s; }
.tabs button.active { background: var(--olive); color: var(--cream-3); }

.faq-main { background: var(--cream); }
.faq-layout { display: grid; grid-template-columns: 1fr 280px; gap: 52px; align-items: start; }
.faq-group { display: none; flex-direction: column; gap: 12px; }
.faq-group.active { display: flex; }

.faq-item { background: var(--white); border: 1px solid var(--line-2); border-radius: 14px; overflow: hidden; box-shadow: var(--shadow-sm); }
.faq-q { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 24px; background: none; border: 0; cursor: pointer; text-align: left; font-family: var(--body); font-weight: 600; font-size: 15.5px; color: var(--ink); }
.faq-q .plus { font-size: 22px; color: var(--gold); transition: .3s; flex: none; line-height: 1; }
.faq-item.open .faq-q .plus { transform: rotate(45deg); }
.faq-a { max-height: 0; overflow: hidden; transition: max-height .4s ease; color: var(--muted); font-size: 14.5px; }
.faq-a p { padding: 0 24px 22px; line-height: 1.75; }
.faq-item.open .faq-a { max-height: 300px; }

.faq-cta-aside { position: sticky; top: 134px; }
.cta-aside-card { background: var(--olive-dark); border-radius: var(--r-lg); padding: 32px 28px; color: var(--cream-3); }
.cta-aside-icon { width: 54px; height: 54px; background: rgba(255,255,255,.1); border-radius: 14px; display: grid; place-items: center; color: var(--gold-2); margin-bottom: 18px; }
.cta-aside-card h3 { font-family: var(--serif); font-weight: 700; font-size: 20px; margin-bottom: 10px; }
.cta-aside-card p { font-size: 14px; color: rgba(251,248,240,.65); line-height: 1.65; }

.inquiry-cta { background: var(--olive); padding: 96px 0; }

@media (max-width: 980px) {
  .faq-layout { grid-template-columns: 1fr; }
  .faq-cta-aside { position: static; }
}
</style>

<script>
  // Tabs
  const tabs = document.getElementById('faqTabs');
  const groups = document.querySelectorAll<HTMLElement>('.faq-group');
  function activateTab(id: string) {
    tabs?.querySelectorAll('button').forEach(b => b.classList.toggle('active', b.dataset.tab === id));
    groups.forEach(g => g.classList.toggle('active', g.dataset.group === id));
  }
  activateTab(document.querySelector<HTMLButtonElement>('.tabs button')?.dataset.tab ?? '');
  tabs?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (btn?.dataset.tab) activateTab(btn.dataset.tab);
  });

  // Accordion
  document.querySelectorAll('.faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const isOpen = item?.classList.contains('open');
      item?.closest('.faq-group')?.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!isOpen) item?.classList.add('open');
    });
  });
</script>
